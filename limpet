#!/usr/bin/env bash
# ABOUTME: limpet — use an external drive as primary storage on macOS, with automatic local failover.
# ABOUTME: Single-file, pure-bash CLI. No kernel extensions, no daemons, no network. See `limpet help`.
set -uo pipefail

LIMPET_VERSION="0.1.0"

# ----------------------------------------------------------------------------- paths
CONFIG_DIR="${LIMPET_CONFIG_DIR:-$HOME/.config/limpet}"
CONFIG="$CONFIG_DIR/config"
MIRROR_LIST="$CONFIG_DIR/mirror-paths.txt"
STATE_DIR="${LIMPET_STATE_DIR:-$HOME/.local/state/limpet}"
LOG="$STATE_DIR/limpet.log"
LABEL="com.limpet.guard"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
REPO="${LIMPET_REPO:-notpritam/limpet}"
SELF="$(cd "$(dirname "$0")" >/dev/null 2>&1 && pwd)/$(basename "$0")"

DRY_RUN="${LIMPET_DRY_RUN:-0}"
ASSUME_YES=0

# ----------------------------------------------------------------------------- ui
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  B=$'\033[1m'; DIM=$'\033[2m'; R=$'\033[0m'
  RED=$'\033[31m'; GRN=$'\033[32m'; YEL=$'\033[33m'; BLU=$'\033[34m'; CYN=$'\033[36m'
else B=""; DIM=""; R=""; RED=""; GRN=""; YEL=""; BLU=""; CYN=""; fi

say()  { printf '%s\n' "$*"; }
info() { printf '%s•%s %s\n' "$CYN" "$R" "$*"; }
ok()   { printf '%s✓%s %s\n' "$GRN" "$R" "$*"; }
warn() { printf '%s!%s %s\n' "$YEL" "$R" "$*" >&2; }
err()  { printf '%s✗%s %s\n' "$RED" "$R" "$*" >&2; }
die()  { err "$*"; exit 1; }
hr()   { printf '%s────────────────────────────────────────────%s\n' "$DIM" "$R"; }
title(){ printf '\n%s%s%s\n' "$B" "$*" "$R"; }

confirm() { # confirm "question"   (auto-yes with --yes)
  [ "$ASSUME_YES" = 1 ] && return 0
  printf '%s?%s %s %s[y/N]%s ' "$YEL" "$R" "$*" "$DIM" "$R"
  local a; read -r a || true
  case "$a" in y|Y|yes|YES) return 0;; *) return 1;; esac
}

ts()  { date '+%Y-%m-%d %H:%M:%S'; }
logln(){ mkdir -p "$STATE_DIR" 2>/dev/null; printf '%s %s\n' "$(ts)" "$*" >> "$LOG"; }

# ----------------------------------------------------------------------------- ui: animation layer
BAR_W=22
_SPIN=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
_BLK=('' ▏ ▎ ▍ ▌ ▋ ▊ ▉)     # sub-cell eighths; index 1..7 (0 unused)

_ui_animated() { [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "$DRY_RUN" != 1 ]; }

_human_kb() { # <kb> -> "512 KB" / "240 MB" / "1.5 GB"
  local kb="${1:-0}"
  if [ "$kb" -ge 1048576 ]; then
    printf '%d.%d GB' "$(( kb / 1048576 ))" "$(( (kb % 1048576) * 10 / 1048576 ))"
  elif [ "$kb" -ge 1024 ]; then
    printf '%d MB' "$(( kb / 1024 ))"
  else
    printf '%d KB' "$kb"
  fi
}

_spin_frame() { printf '%s' "${_SPIN[$(( ${1:-0} % 10 ))]}"; }

_rep() { # <char> <count> -> char repeated count times.
  # MUST use printf-pad + substitution, NOT a `out="$out█"` loop: bash 3.2 under a
  # UTF-8 locale corrupts iterative multibyte self-append (verified — produces garbage).
  local ch="${1:-}" n="${2:-0}"; [ "$n" -le 0 ] && return 0
  local s; s="$(printf "%${n}s" "")"; printf '%s' "${s// /$ch}"
}

_bar_str() { # <pct> <width> -> "████▏░░░"  (plain; caller adds color)
  local pct="${1:-0}" w="${2:-$BAR_W}"
  [ "$pct" -gt 100 ] && pct=100; [ "$pct" -lt 0 ] && pct=0
  local eighths=$(( pct * w * 8 / 100 )) full=$(( pct * w * 8 / 100 / 8 )) part mid="" rest
  part=$(( eighths % 8 )); rest=$(( w - full ))
  if [ "$part" -gt 0 ] && [ "$full" -lt "$w" ]; then mid="${_BLK[$part]}"; rest=$(( rest - 1 )); fi
  printf '%s%s%s' "$(_rep █ "$full")" "$mid" "$(_rep ░ "$rest")"
}

ROW_LABEL=(); ROW_STATE=(); ROW_PCT=(); ROW_TOTKB=(); ROW_DSTKB=()
ROWS_H=0; SHOW_AGG=0; ROW_CUR=-1; FRAME=0

_du_kb() { local k; k="$(du -sk "$1" 2>/dev/null | awk 'NR==1{print $1}')"; echo "${k:-0}"; }
_in_block() { _ui_animated && [ "$ROW_CUR" -ge 0 ]; }

_rows_begin() { ROW_LABEL=(); ROW_STATE=(); ROW_PCT=(); ROW_TOTKB=(); ROW_DSTKB=(); SHOW_AGG="${1:-0}"; ROWS_H=0; }
_rows_add()   { ROW_LABEL+=("$1"); ROW_TOTKB+=("${2:-0}"); ROW_DSTKB+=(0); ROW_PCT+=(0); ROW_STATE+=(queued); }

_row_line() { # <idx>
  local i="$1" glyph gcls barcls
  case "${ROW_STATE[$i]}" in
    queued)   glyph='○'; gcls="$DIM";  barcls="$DIM" ;;
    done)     glyph='✓'; gcls="$GRN";  barcls="$GRN" ;;
    failed)   glyph='✗'; gcls="$RED";  barcls="$RED" ;;
    verifying)glyph="$(_spin_frame $FRAME)"; gcls="$CYN"; barcls="$CYN" ;;
    *)        glyph="$(_spin_frame $FRAME)"; gcls="$CYN"; barcls="$CYN" ;;
  esac
  local size
  if [ "${ROW_STATE[$i]}" = queued ]; then size="${DIM}queued${R}"
  elif [ "${ROW_STATE[$i]}" = done ]; then size="$(_human_kb "${ROW_TOTKB[$i]}")"
  else size="$(_human_kb "${ROW_DSTKB[$i]}") / $(_human_kb "${ROW_TOTKB[$i]}")"; fi
  printf '  %s%s%s %s%-12s%s %s%s%s  %s%3d%%%s   %s%s%s' \
    "$gcls" "$glyph" "$R" "$B" "${ROW_LABEL[$i]}" "$R" \
    "$barcls" "$(_bar_str "${ROW_PCT[$i]}" "$BAR_W")" "$R" \
    "$gcls" "${ROW_PCT[$i]}" "$R" "$DIM" "$size" "$R"
}
_agg_line() {
  local i=0 done=0 tot=0
  while [ "$i" -lt "${#ROW_TOTKB[@]}" ]; do
    tot=$(( tot + ROW_TOTKB[i] )); done=$(( done + ROW_TOTKB[i] * ROW_PCT[i] / 100 )); i=$(( i + 1 ))
  done
  printf '  %s▸%s %s%s of %s · verified byte-for-byte before removal%s' \
    "$CYN" "$R" "$DIM" "$(_human_kb "$done")" "$(_human_kb "$tot")" "$R"
}

_rows_paint() {
  _ui_animated || return 0
  local i=0
  while [ "$i" -lt "${#ROW_LABEL[@]}" ]; do _row_line "$i"; printf '\n'; i=$(( i + 1 )); done
  [ "$SHOW_AGG" = 1 ] && { _agg_line; printf '\n'; }
  ROWS_H=$(( ${#ROW_LABEL[@]} + ( SHOW_AGG == 1 ? 1 : 0 ) ))
}
_rows_update() {
  _ui_animated || return 0
  FRAME=$(( FRAME + 1 ))
  tput cuu "$ROWS_H"
  local i=0
  while [ "$i" -lt "${#ROW_LABEL[@]}" ]; do printf '\r'; tput el; _row_line "$i"; printf '\n'; i=$(( i + 1 )); done
  [ "$SHOW_AGG" = 1 ] && { printf '\r'; tput el; _agg_line; printf '\n'; }
}
_rows_state() { _in_block || return 0; ROW_STATE[$ROW_CUR]="$1"; _rows_update; }
_rows_done()  { _in_block || return 0; ROW_STATE[$ROW_CUR]=done; ROW_PCT[$ROW_CUR]=100; _rows_update; }
_rows_fail()  { _in_block || return 0; ROW_STATE[$ROW_CUR]=failed; _rows_update; }

_run_poll() { # <idx> <dst> -- cmd... : run the copy cmd in bg, poll dst size -> row pct. Plain cmd off-TTY.
  local idx="$1" dst="$2"; shift 2; [ "${1:-}" = "--" ] && shift
  if ! _ui_animated || [ "$idx" -lt 0 ]; then "$@"; return $?; fi
  local tot="${ROW_TOTKB[$idx]}" d p
  ROW_STATE[$idx]=copying
  "$@" & local pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    d="$(_du_kb "$dst")"; ROW_DSTKB[$idx]="$d"
    p=0; [ "$tot" -gt 0 ] && p=$(( d * 100 / tot )); [ "$p" -gt 99 ] && p=99
    [ "$p" -lt "${ROW_PCT[$idx]}" ] && p="${ROW_PCT[$idx]}"   # monotonic
    ROW_PCT[$idx]="$p"; _rows_update; sleep 0.2
  done
  wait "$pid"; return $?
}

spin() { # spin "label" -- cmd...
  local label="$1"; shift; [ "${1:-}" = "--" ] && shift
  if ! _ui_animated; then "$@"; return $?; fi
  "$@" & local pid=$! i=0
  tput civis 2>/dev/null
  while kill -0 "$pid" 2>/dev/null; do printf '\r  %s%s%s %s' "$CYN" "$(_spin_frame $i)" "$R" "$label …"; tput el; i=$(( i + 1 )); sleep 0.08; done
  wait "$pid"; local st=$?
  tput cnorm 2>/dev/null
  printf '\r'; tput el
  if [ "$st" = 0 ]; then ok "$label"; else err "$label"; fi
  return $st
}

# ----------------------------------------------------------------------------- config
DRIVE=""
FOLDERS=()
MIRROR_DEST="$HOME/.limpet/mirror"
AUTO_UPDATE=0

load_config() { [ -f "$CONFIG" ] && . "$CONFIG"; }
require_config() {
  load_config
  [ -n "$DRIVE" ] || die "limpet is not set up yet. Run: ${B}limpet setup${R}"
}
save_config() {
  mkdir -p "$CONFIG_DIR"
  {
    echo "# limpet config — edit with care, or re-run \`limpet setup\`"
    printf 'DRIVE=%q\n' "$DRIVE"
    printf 'FOLDERS=('; for f in "${FOLDERS[@]}"; do printf '%q ' "$f"; done; printf ')\n'
    printf 'MIRROR_DEST=%q\n' "$MIRROR_DEST"
    printf 'AUTO_UPDATE=%q\n' "$AUTO_UPDATE"
  } > "$CONFIG"
  [ -f "$MIRROR_LIST" ] || cat > "$MIRROR_LIST" <<EOF
# limpet — paths under the drive to keep mirrored to a local fallback copy,
# so important files stay readable when the drive is unplugged.
# One path per line, RELATIVE to the drive root. '#' = comment.
EOF
}

drive_present() { [ -n "$DRIVE" ] && [ -d "$DRIVE" ]; }

# ----------------------------------------------------------------------------- lock
with_lock() { # with_lock <name> <command...>
  local name="$1"; shift
  local lock="$STATE_DIR/$name.lock.d"
  mkdir -p "$STATE_DIR" 2>/dev/null
  [ -d "$lock" ] && find "$lock" -maxdepth 0 -mmin +2 2>/dev/null | grep -q . && rmdir "$lock" 2>/dev/null
  if ! mkdir "$lock" 2>/dev/null; then logln "[$name] skip: another instance running"; return 0; fi
  trap 'rmdir "'"$lock"'" 2>/dev/null' RETURN
  "$@"
}

# ----------------------------------------------------------------------------- verified move + link
_manifest() { # sha of every file/symlink path+size (ignores volatile macOS sidecars)
  ( cd "$1" 2>/dev/null && find . \( -type f -o -type l \) ! -name .DS_Store ! -name '._*' -print0 \
      | LC_ALL=C sort -z | xargs -0 stat -f '%N|%z' 2>/dev/null ) | shasum | awk '{print $1}'
}
verify_copy() { # verify_copy <src> <dst>  -> 0 if identical
  local s="$1" d="$2"
  if [ -d "$s" ]; then [ -n "$(_manifest "$s")" ] && [ "$(_manifest "$s")" = "$(_manifest "$d")" ]
  else [ "$(shasum "$s" | awk '{print $1}')" = "$(shasum "$d" | awk '{print $1}')" ]; fi
}

# move_to_drive <abs-src> <abs-dst> [label] : ditto-copy, verify, then delete src + symlink it to dst
move_to_drive() {
  local src="$1" dst="$2" label="${3:-$(basename "$dst")}"
  [ -L "$src" ] && { _in_block && { _rows_done; return 0; }; info "already a symlink: ${DIM}$src${R}"; return 0; }
  [ -e "$src" ] || { ln -s "$dst" "$src"; return 0; }
  local standalone=0
  if [ -e "$dst" ] && [ ! -L "$dst" ]; then
    _in_block || warn "destination already exists, verifying instead of copying: $dst"
  else
    if [ "$DRY_RUN" = 1 ]; then say "${DIM}[dry-run] ditto '$src' '$dst'${R}"; return 0; fi
    if _ui_animated && [ "$ROW_CUR" -lt 0 ]; then _rows_begin 0; _rows_add "$label" "$(_du_kb "$src")"; _rows_paint; ROW_CUR=0; standalone=1; fi
    _run_poll "$ROW_CUR" "$dst" -- ditto "$src" "$dst" || { _rows_fail; err "copy failed: $src"; [ "$standalone" = 1 ] && ROW_CUR=-1; return 1; }
  fi
  [ "$DRY_RUN" = 1 ] && { say "${DIM}[dry-run] verify + replace '$src' with symlink${R}"; return 0; }
  _rows_state verifying
  verify_copy "$src" "$dst" || { _rows_fail; err "verify FAILED — leaving original intact: $src"; [ "$standalone" = 1 ] && ROW_CUR=-1; return 1; }
  chmod -N "$src" 2>/dev/null
  rm -rf "$src" && ln -s "$dst" "$src" || { _rows_fail; err "swap failed (data is safe at $dst)"; [ "$standalone" = 1 ] && ROW_CUR=-1; return 1; }
  _rows_done
  [ "$standalone" = 1 ] && ROW_CUR=-1
  return 0
}

# ----------------------------------------------------------------------------- the guard (failover/failback)
_guard_one() {
  local name="$1" local_path="$HOME/$1" x9="$DRIVE/$1"
  if drive_present; then
    mkdir -p "$x9" 2>/dev/null
    if [ -L "$local_path" ]; then
      [ "$(readlink "$local_path")" != "$x9" ] && { ln -sfn "$x9" "$local_path"; logln "[guard] fixed $name link"; }
      return 0
    fi
    if [ -e "$local_path" ]; then                     # real local folder from a failover -> merge back
      logln "[guard] failback $name: merging local files back to drive"
      local f base new; shopt -s dotglob nullglob
      for f in "$local_path"/*; do
        base="$(basename "$f")"; [ "$base" = ".DS_Store" ] && { rm -f "$f"; continue; }
        if [ -e "$x9/$base" ]; then new="${base}.local-$(date +%Y%m%d-%H%M%S)"; mv "$f" "$x9/$new" && logln "[guard]   kept-both: $base -> $new"
        else mv "$f" "$x9/" 2>/dev/null || logln "[guard]   could not move $base (drive not writable here)"; fi
      done
      shopt -u dotglob nullglob
      chmod -N "$local_path" 2>/dev/null
      if rmdir "$local_path" 2>/dev/null; then ln -sfn "$x9" "$local_path"; logln "[guard] failback $name complete"
      else logln "[guard] failback $name: local dir not empty (drive not writable here) — left for terminal run"; fi
      return 0
    fi
    ln -sfn "$x9" "$local_path"; logln "[guard] created $name link"
  else                                                # drive gone -> become a real local folder
    if [ -L "$local_path" ]; then rm -f "$local_path" && mkdir -p "$local_path" && logln "[guard] failover $name -> local folder"
    elif [ ! -e "$local_path" ]; then mkdir -p "$local_path"; fi
  fi
}
run_guard() {
  load_config; [ -n "$DRIVE" ] || exit 0
  logln "[guard] run: drive $(drive_present && echo PRESENT || echo ABSENT)"
  local f; for f in "${FOLDERS[@]}"; do _guard_one "$f"; done
}

# ----------------------------------------------------------------------------- the mirror
run_mirror() {
  load_config; [ -n "$DRIVE" ] || exit 0
  drive_present || { logln "[mirror] drive absent — keeping existing mirror"; return 0; }
  [ -f "$MIRROR_LIST" ] || return 0
  mkdir -p "$MIRROR_DEST"
  local line src dst n=0 entries=()
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"; case "$line" in ''|\#*) continue;; esac
    [ -e "$DRIVE/$line" ] || { logln "[mirror] skip missing: $line"; continue; }
    entries+=("$line")
  done < "$MIRROR_LIST"
  [ "${#entries[@]}" -eq 0 ] && { logln "[mirror] done (0 mirrored)"; return 0; }

  if _ui_animated; then title "Mirroring ${#entries[@]} path(s) → $MIRROR_DEST"; _rows_begin 0
  for line in "${entries[@]}"; do _rows_add "$line" "$(_du_kb "$DRIVE/$line")"; done; _rows_paint; fi

  local _i=0
  for line in "${entries[@]}"; do
    src="$DRIVE/$line"; dst="$MIRROR_DEST/$line"; mkdir -p "$(dirname "$dst")"
    if _ui_animated; then ROW_CUR=$_i; else ROW_CUR=-1; fi   # NB: don't put _ui_animated in $(...) — [ -t 1 ] is false in a subshell pipe
    if [ -d "$src" ]; then mkdir -p "$dst"; _run_poll "$ROW_CUR" "$dst" -- rsync -a --delete "$src/" "$dst/" 2>>"$LOG" && { n=$((n+1)); _rows_done; } || _rows_fail
    else _run_poll "$ROW_CUR" "$dst" -- rsync -a "$src" "$dst" 2>>"$LOG" && { n=$((n+1)); _rows_done; } || _rows_fail; fi
    _i=$(( _i + 1 ))
  done
  ROW_CUR=-1
  logln "[mirror] done ($n mirrored)"
}

# ----------------------------------------------------------------------------- agent + shell hook
HOOK_BEGIN="# >>> limpet self-heal >>>"
HOOK_END="# <<< limpet self-heal <<<"

install_agent() {
  mkdir -p "$(dirname "$PLIST")"
  cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key><array><string>$SELF</string><string>__guard</string></array>
  <key>RunAtLoad</key><true/>
  <key>WatchPaths</key><array><string>/Volumes</string></array>
  <key>StandardOutPath</key><string>$STATE_DIR/agent.out</string>
  <key>StandardErrorPath</key><string>$STATE_DIR/agent.err</string>
</dict></plist>
EOF
  launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
  launchctl bootstrap "gui/$(id -u)" "$PLIST" 2>/dev/null || launchctl load -w "$PLIST" 2>/dev/null || true
}
uninstall_agent() {
  launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || launchctl unload "$PLIST" 2>/dev/null || true
  rm -f "$PLIST"
}

shell_rc() { # echo the rc files that exist
  for rc in "$HOME/.zshrc" "$HOME/.bashrc"; do [ -f "$rc" ] && echo "$rc"; done
}
install_hook() {
  local rc; for rc in $(shell_rc); do
    grep -q "$HOOK_BEGIN" "$rc" 2>/dev/null && continue
    cat >> "$rc" <<EOF

$HOOK_BEGIN
# Runs the guard + mirror from your terminal (which has disk access), throttled.
if [ -n "\${PS1:-}" ] || [[ \$- == *i* ]]; then ( \
  _ls="$STATE_DIR"; mkdir -p "\$_ls" 2>/dev/null; _now=\$(date +%s); \
  if [ \$(( _now - \$(cat "\$_ls/guard.stamp" 2>/dev/null || echo 0) )) -ge 60 ]; then echo "\$_now" > "\$_ls/guard.stamp"; "$SELF" __guard >/dev/null 2>&1; fi; \
  if [ \$(( _now - \$(cat "\$_ls/mirror.stamp" 2>/dev/null || echo 0) )) -ge 3600 ]; then echo "\$_now" > "\$_ls/mirror.stamp"; "$SELF" __mirror >/dev/null 2>&1; fi; \
  "$SELF" __autoupdate >/dev/null 2>&1 \
  ) &
fi
$HOOK_END
EOF
    ok "added self-heal hook to ${DIM}$rc${R}"
  done
}
uninstall_hook() {
  local rc; for rc in $(shell_rc); do
    [ -f "$rc" ] || continue
    grep -q "$HOOK_BEGIN" "$rc" || continue
    # delete the marked block (portable, no in-place sed -i differences)
    awk -v b="$HOOK_BEGIN" -v e="$HOOK_END" '
      $0==b{skip=1} skip{ if($0==e) skip=0; next } {print}' "$rc" > "$rc.limpet.tmp" && mv "$rc.limpet.tmp" "$rc"
    ok "removed self-heal hook from ${DIM}$rc${R}"
  done
}

# ----------------------------------------------------------------------------- drive detection
list_external_drives() { # prints mounted volumes that look like real external disks
  local v
  for v in /Volumes/*; do
    [ -d "$v" ] || continue
    [ "$v" = "/Volumes/Macintosh HD" ] && continue
    [ -L "$v" ] && continue
    echo "$v"
  done
}

# ----------------------------------------------------------------------------- self-update (GitHub Releases)
_latest_version() { curl -fsSL --max-time 6 "https://api.github.com/repos/$REPO/releases/latest" 2>/dev/null | awk -F'"' '/"tag_name"/{print $4; exit}' | sed 's/^v//'; }
_ver_gt() { [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -t. -k1,1n -k2,2n -k3,3n | tail -1)" = "$1" ]; }
_do_update() {
  local v="$1" tmp; tmp="$(mktemp)"
  spin "downloading v$v" -- bash -c '
    curl -fsSL --max-time 30 "https://github.com/'"$REPO"'/releases/download/v'"$v"'/limpet" -o "'"$tmp"'" 2>/dev/null \
      || curl -fsSL --max-time 30 "https://raw.githubusercontent.com/'"$REPO"'/v'"$v"'/limpet" -o "'"$tmp"'" 2>/dev/null' || return 1
  /bin/bash -n "$tmp" || return 1
  chmod +x "$tmp"
  if [ -w "$SELF" ]; then mv "$tmp" "$SELF"; else sudo mv "$tmp" "$SELF" 2>/dev/null || mv "$tmp" "$SELF"; fi
}
cmd_update() {
  local check=0; [ "${1:-}" = "--check" ] && check=1
  info "current v$LIMPET_VERSION — checking $REPO …"
  local latest; latest="$(_latest_version)"
  [ -n "$latest" ] || die "couldn't reach GitHub releases (offline?)."
  if ! _ver_gt "$latest" "$LIMPET_VERSION"; then ok "already on the latest (v$LIMPET_VERSION)."; rm -f "$STATE_DIR/update-available"; return 0; fi
  warn "update available: v$LIMPET_VERSION → ${B}v$latest${R}"
  [ "$check" = 1 ] && { say "run ${B}limpet update${R} to install."; return 0; }
  confirm "install v$latest now?" || return 0
  _do_update "$latest" && { ok "updated to v$latest."; rm -f "$STATE_DIR/update-available"; } || die "update failed."
}
cmd_autoupdate() { # internal: daily check; auto-applies if AUTO_UPDATE=1, else records availability for a notice
  load_config; mkdir -p "$STATE_DIR"; local now; now=$(date +%s)
  [ $(( now - $(cat "$STATE_DIR/update-check.stamp" 2>/dev/null || echo 0) )) -ge 86400 ] || return 0
  echo "$now" > "$STATE_DIR/update-check.stamp"
  local latest; latest="$(_latest_version)"; [ -n "$latest" ] || return 0
  if _ver_gt "$latest" "$LIMPET_VERSION"; then
    if [ "${AUTO_UPDATE:-0}" = "1" ]; then _do_update "$latest" && logln "[update] auto-updated v$LIMPET_VERSION -> v$latest"; rm -f "$STATE_DIR/update-available"
    else echo "$latest" > "$STATE_DIR/update-available"; fi
  else rm -f "$STATE_DIR/update-available"; fi
}
_notice() { local a; a="$(cat "$STATE_DIR/update-available" 2>/dev/null)"; [ -n "$a" ] && _ver_gt "$a" "$LIMPET_VERSION" && [ -t 1 ] && warn "limpet ${B}v$a${R} is available — run ${B}limpet update${R}"; return 0; }

# ----------------------------------------------------------------------------- list
_is_managed() { local b="${1#$HOME/}"; case " ${FOLDERS[*]} " in *" $b "*) return 0;; esac; return 1; }
cmd_list() {
  require_config
  title "managed folders → $DRIVE"
  local f
  for f in "${FOLDERS[@]}"; do
    if [ -L "$HOME/$f" ]; then printf '  %s✓%s ~/%-12s → %s\n' "$GRN" "$R" "$f" "$(readlink "$HOME/$f")"
    elif [ -d "$HOME/$f" ]; then printf '  %s•%s ~/%-12s %s(local — failover mode)%s\n' "$BLU" "$R" "$f" "$DIM" "$R"
    else printf '  %s?%s ~/%-12s %s(missing)%s\n' "$YEL" "$R" "$f" "$DIM" "$R"; fi
  done
  title "other links into the drive ${DIM}(ad-hoc, made with \`limpet link\`)${R}"
  local found=0 l tg
  while IFS= read -r l; do
    _is_managed "$l" && continue
    tg="$(readlink "$l" 2>/dev/null)"; case "$tg" in "$DRIVE"/*) printf '  %s↪%s %s → %s\n' "$CYN" "$R" "${l/#$HOME/~}" "$tg"; found=1;; esac
  done < <(find "$HOME" -maxdepth 2 -type l 2>/dev/null)
  [ "$found" = 0 ] && say "  ${DIM}none${R}"
}

# ----------------------------------------------------------------------------- commands
cmd_setup() {
  local pre_drive="" pre_folders="" pre_mirror=""
  while [ $# -gt 0 ]; do case "$1" in
    --drive) pre_drive="$2"; shift 2;;
    --folders) pre_folders="$2"; shift 2;;
    --mirror) pre_mirror="$2"; shift 2;;
    --yes|-y) ASSUME_YES=1; shift;;
    --dry-run) DRY_RUN=1; shift;;
    *) die "unknown setup option: $1";;
  esac; done

  title "limpet setup"
  say "Make an external drive your primary storage, with automatic local failover."
  hr
  if [ -f "$CONFIG" ]; then
    load_config
    ok "Existing limpet setup detected — drive ${B}$DRIVE${R}, folders: ${B}${FOLDERS[*]}${R}"
    say "${DIM}Re-running is safe: already-linked folders are kept as-is (no re-copy).${R}"; hr
  fi

  # 1) drive
  if [ -n "$pre_drive" ]; then DRIVE="$pre_drive"
  else
    local drives=(); while IFS= read -r d; do drives+=("$d"); done < <(list_external_drives)
    [ "${#drives[@]}" -gt 0 ] || die "No external drive found under /Volumes. Plug one in and retry."
    say "${B}Which drive should be primary?${R}"
    local i=1; for d in "${drives[@]}"; do printf '  %s%d%s) %s\n' "$CYN" "$i" "$R" "$d"; i=$((i+1)); done
    printf '%s?%s pick a number: ' "$YEL" "$R"; local pick; read -r pick || true
    case "$pick" in ''|*[!0-9]*) die "not a number";; esac
    [ "$pick" -ge 1 ] && [ "$pick" -le "${#drives[@]}" ] || die "out of range"
    DRIVE="${drives[$((pick-1))]}"
  fi
  [ -d "$DRIVE" ] || die "drive not mounted: $DRIVE"
  ok "drive: ${B}$DRIVE${R}"

  # 2) folders
  if [ -n "$pre_folders" ]; then IFS=',' read -ra FOLDERS <<< "$pre_folders"
  else
    say ""; say "${B}Which home folders should live on the drive?${R} ${DIM}(comma-separated)${R}"
    printf '  %sdefault:%s Documents,Downloads,Desktop  — press Enter to accept: ' "$DIM" "$R"
    local fin; read -r fin || true
    [ -z "$fin" ] && fin="Documents,Downloads,Desktop"
    IFS=',' read -ra FOLDERS <<< "$fin"
  fi
  ok "folders: ${B}${FOLDERS[*]}${R}"

  [ -n "$pre_mirror" ] && { mkdir -p "$CONFIG_DIR"; printf '%s\n' "${pre_mirror//,/$'\n'}" >> "$MIRROR_LIST"; }

  # auto-update preference
  if [ "$ASSUME_YES" != 1 ]; then confirm "Check for limpet updates automatically?" && AUTO_UPDATE=1 || AUTO_UPDATE=0; fi

  # 3) confirm
  say ""; warn "This will MOVE each folder's contents onto $DRIVE (verified copy first), replace them with"
  warn "symlinks, and install a background guard + a terminal hook. Existing data is never deleted before"
  warn "its copy is byte-verified."
  confirm "Proceed?" || { say "aborted."; return 1; }

  # 4) do it
  hr
  local f
  if _ui_animated; then
    title "Moving your folders onto ${B}$DRIVE${R} …"
    _rows_begin 1
    for f in "${FOLDERS[@]}"; do _rows_add "$f" "$(_du_kb "$HOME/$f")"; done
    _rows_paint
    local _i=0
    for f in "${FOLDERS[@]}"; do
      ROW_CUR=$_i
      move_to_drive "$HOME/$f" "$DRIVE/$f" "$f" || true
      _i=$(( _i + 1 ))
    done
    ROW_CUR=-1
  else
    for f in "${FOLDERS[@]}"; do
      info "linking ${B}$f${R} → $DRIVE/$f"
      move_to_drive "$HOME/$f" "$DRIVE/$f" "$f" && ok "$f is now on the drive" || err "$f failed (left intact)"
    done
  fi
  save_config
  [ "$DRY_RUN" = 1 ] || { install_agent; install_hook; }
  hr
  ok "${B}Setup complete.${R}"
  say "  • Background guard: ${GRN}active${R} (reacts to plug/unplug instantly)"
  say "  • Terminal hook: added (merges offline work back + mirrors). Open a new terminal to activate."
  say "  • Check anytime with ${B}limpet status${R}, or ${B}limpet doctor${R}."
}

cmd_status() {
  load_config
  local json=0; [ "${1:-}" = "--json" ] && json=1
  [ -n "$DRIVE" ] || { [ "$json" = 1 ] && echo '{"setup":false}' || die "not set up — run: limpet setup"; return; }
  local present="false"; drive_present && present="true"
  local agent="false"; launchctl list 2>/dev/null | grep -q "$LABEL" && agent="true"
  if [ "$json" = 1 ]; then
    printf '{"setup":true,"drive":"%s","drive_present":%s,"agent_loaded":%s,"folders":[' "$DRIVE" "$present" "$agent"
    local first=1 f t st
    for f in "${FOLDERS[@]}"; do
      [ -L "$HOME/$f" ] && st="symlink" || { [ -d "$HOME/$f" ] && st="local" || st="missing"; }
      t="$(readlink "$HOME/$f" 2>/dev/null)"
      [ "$first" = 1 ] || printf ','; first=0
      printf '{"name":"%s","state":"%s","target":"%s"}' "$f" "$st" "$t"
    done
    printf ']}\n'; return
  fi
  title "limpet status"
  say "drive:   ${B}$DRIVE${R}  $( [ "$present" = true ] && printf '%sconnected%s' "$GRN" "$R" || printf '%sUNPLUGGED%s' "$YEL" "$R" )"
  say "guard:   $( [ "$agent" = true ] && printf '%sloaded%s' "$GRN" "$R" || printf '%snot loaded%s' "$RED" "$R" )"
  hr
  local f t
  for f in "${FOLDERS[@]}"; do
    if [ -L "$HOME/$f" ]; then t="$(readlink "$HOME/$f")"; [ -e "$HOME/$f" ] && printf '  %s✓%s ~/%-10s → %s\n' "$GRN" "$R" "$f" "$t" || printf '  %s✗%s ~/%-10s → %s %s(broken — drive unplugged)%s\n' "$YEL" "$R" "$f" "$t" "$DIM" "$R"
    elif [ -d "$HOME/$f" ]; then printf '  %s•%s ~/%-10s %s(local folder — failover mode)%s\n' "$BLU" "$R" "$f" "$DIM" "$R"
    else printf '  %s?%s ~/%-10s %s(missing)%s\n' "$YEL" "$R" "$f" "$DIM" "$R"; fi
  done
}

cmd_doctor() {
  require_config
  title "limpet doctor"
  local issues=0
  drive_present && ok "drive mounted: $DRIVE" || { warn "drive not mounted ($DRIVE) — folders are in failover mode"; }
  launchctl list 2>/dev/null | grep -q "$LABEL" && ok "guard agent loaded" || { warn "guard agent NOT loaded"; issues=$((issues+1)); confirm "reinstall the agent?" && { install_agent; ok "reinstalled"; }; }
  [ -x "$SELF" ] && ok "cli present: $SELF" || warn "cli path looks off: $SELF"
  # drive-name drift gotcha (e.g. "/Volumes/X9 1")
  if ! drive_present && [ -n "$(ls -d "${DRIVE} "* 2>/dev/null)" ]; then
    warn "Your drive may have remounted under a different name (e.g. '${DRIVE} 1')."
    warn "Eject it cleanly and replug so it returns to '$DRIVE'."
    issues=$((issues+1))
  fi
  hr
  [ "$issues" = 0 ] && ok "all good." || warn "$issues issue(s) above."
}

cmd_link() { # limpet link <path>   (move any extra file/folder onto the drive + symlink)
  require_config; drive_present || die "drive not mounted"
  local p="${1:-}"; [ -n "$p" ] || die "usage: limpet link <path>"
  [ -e "$p" ] || die "no such path: $p"
  local abs; abs="$(cd "$(dirname "$p")" && pwd)/$(basename "$p")"
  case "$abs" in "$DRIVE"/*) die "already on the drive";; esac
  local dst="$DRIVE/$(basename "$abs")"
  [ -e "$dst" ] && die "destination exists: $dst"
  info "moving ${B}$abs${R} → $dst"
  move_to_drive "$abs" "$dst" "$(basename "$abs")" && ok "linked." || err "failed."
}
cmd_unlink() { # limpet unlink <path>  (bring a symlinked path back to local disk)
  local p="${1:-}"; [ -n "$p" ] || die "usage: limpet unlink <path>"
  [ -L "$p" ] || die "not a symlink: $p"
  require_config; drive_present || die "drive not mounted (needed to copy data back)"
  local tgt; tgt="$(readlink "$p")"
  [ "$DRY_RUN" = 1 ] && { say "${DIM}[dry-run] copy $tgt back to $p${R}"; return; }
  rm -f "$p"; ditto "$tgt" "$p" && ok "restored to local disk: $p" || err "failed"
}

cmd_sync() {
  require_config
  spin "failover / failback" -- with_lock guard run_guard
  with_lock mirror run_mirror
  ok "synced."
}

cmd_uninstall() {
  load_config
  title "limpet uninstall"
  warn "This removes the guard agent and the terminal hook."
  uninstall_agent; uninstall_hook
  if [ -n "$DRIVE" ] && confirm "Also turn the symlinked folders back into normal LOCAL folders (copies data back from the drive)?"; then
    drive_present || die "drive must be mounted to copy data back"
    local f; for f in "${FOLDERS[@]}"; do [ -L "$HOME/$f" ] && { rm -f "$HOME/$f"; ditto "$DRIVE/$f" "$HOME/$f" && ok "$f restored locally"; }; done
  fi
  ok "limpet uninstalled. (config left at $CONFIG_DIR — delete it to fully reset.)"
}

cmd_help() {
  cat <<EOF
${B}limpet${R} ${DIM}v$LIMPET_VERSION${R} — external drive as primary storage on macOS, with automatic local failover.

${B}USAGE${R}
  limpet <command> [options]

${B}COMMANDS${R}
  ${CYN}setup${R}            Interactive wizard: pick a drive + folders, move them over, install the guard.
                   Flags for automation: --drive <path> --folders a,b,c [--mirror p1,p2] --yes
  ${CYN}status${R}           Show drive + folder state. Add --json for machine output.
  ${CYN}doctor${R}           Health-check and offer fixes.
  ${CYN}sync${R}             Run the failover/failback + mirror right now.
  ${CYN}link${R} <path>      Move any extra file/folder onto the drive and symlink it back.
  ${CYN}unlink${R} <path>    Bring a symlinked path back onto the local disk.
  ${CYN}list${R}             List managed folders + any ad-hoc links into the drive.
  ${CYN}update${R}           Update limpet to the latest release (--check just checks).
  ${CYN}uninstall${R}        Remove the guard + hook (optionally restore folders to local).
  ${CYN}help${R} | ${CYN}version${R}   This help / version.

${B}GLOBAL${R}
  --yes, -y        Don't prompt (for scripts/agents).
  --dry-run        Print actions without changing anything.

${B}HOW IT WORKS${R}
  Folders become symlinks to the drive. A background ${B}guard${R} (launchd, watches /Volumes) flips them to
  real local folders the instant the drive is unplugged, and back when it returns — merging anything you
  saved offline, never overwriting. A terminal hook finishes the parts macOS won't let a background job do.
  No kernel extensions, no daemons, no network.
EOF
}

# ----------------------------------------------------------------------------- dispatch
main() {
  local cmd="${1:-help}"; shift || true
  # pull global flags out of the args
  local args=(); while [ $# -gt 0 ]; do case "$1" in
    --yes|-y) ASSUME_YES=1;; --dry-run) DRY_RUN=1;; *) args+=("$1");; esac; shift; done
  set -- ${args[@]+"${args[@]}"}
  _notice
  case "$cmd" in
    setup)        cmd_setup "$@";;
    status)       cmd_status "$@";;
    doctor)       cmd_doctor;;
    sync)         cmd_sync;;
    link)         cmd_link "$@";;
    unlink)       cmd_unlink "$@";;
    list)         cmd_list;;
    update)       cmd_update "$@";;
    uninstall)    cmd_uninstall;;
    __guard)      with_lock guard run_guard;;     # internal: called by launchd + hook
    __mirror)     with_lock mirror run_mirror;;   # internal: called by hook
    __autoupdate) cmd_autoupdate;;                # internal: called by hook (daily)
    version|-v|--version) say "limpet $LIMPET_VERSION";;
    help|-h|--help) cmd_help;;
    *) err "unknown command: $cmd"; say "run ${B}limpet help${R}"; exit 1;;
  esac
}
if [ "${BASH_SOURCE[0]:-$0}" = "$0" ]; then main "$@"; fi
