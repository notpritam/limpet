#!/usr/bin/env bash
# ABOUTME: limpet — use an external drive as primary storage on macOS, with automatic local failover.
# ABOUTME: Single-file, pure-bash CLI. No kernel extensions, no daemons, no network. See `limpet help`.
set -uo pipefail

LIMPET_VERSION="0.4.0"

# ----------------------------------------------------------------------------- paths
CONFIG_DIR="${LIMPET_CONFIG_DIR:-$HOME/.config/limpet}"
CONFIG="$CONFIG_DIR/config"
MIRROR_LIST="$CONFIG_DIR/mirror-paths.txt"
ENV_CONF="$CONFIG_DIR/env.conf"
ORGANIZE_CONF="$CONFIG_DIR/organize.conf"
ORGANIZE_RULES="$CONFIG_DIR/organize-rules.conf"
STATE_DIR="${LIMPET_STATE_DIR:-$HOME/.local/state/limpet}"
LOG="$STATE_DIR/limpet.log"
LABEL="com.limpet.guard"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
REPO="${LIMPET_REPO:-notpritam/limpet}"
SELF="$(cd "$(dirname "$0")" >/dev/null 2>&1 && pwd)/$(basename "$0")"

DRY_RUN="${LIMPET_DRY_RUN:-0}"
ASSUME_YES=0

# ----------------------------------------------------------------------------- ui
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  B=$'\033[1m'; DIM=$'\033[2m'; R=$'\033[0m'
  RED=$'\033[31m'; GRN=$'\033[32m'; YEL=$'\033[33m'; BLU=$'\033[34m'; CYN=$'\033[36m'
else B=""; DIM=""; R=""; RED=""; GRN=""; YEL=""; BLU=""; CYN=""; fi

say()  { printf '%s\n' "$*"; }
info() { printf '%s•%s %s\n' "$CYN" "$R" "$*"; }
ok()   { printf '%s✓%s %s\n' "$GRN" "$R" "$*"; }
warn() { printf '%s!%s %s\n' "$YEL" "$R" "$*" >&2; }
err()  { printf '%s✗%s %s\n' "$RED" "$R" "$*" >&2; }
die()  { err "$*"; exit 1; }
hr()   { printf '%s────────────────────────────────────────────%s\n' "$DIM" "$R"; }
title(){ printf '\n%s%s%s\n' "$B" "$*" "$R"; }

confirm() { # confirm "question"   (auto-yes with --yes)
  [ "$ASSUME_YES" = 1 ] && return 0
  printf '%s?%s %s %s[y/N]%s ' "$YEL" "$R" "$*" "$DIM" "$R"
  local a; read -r a || true
  case "$a" in y|Y|yes|YES) return 0;; *) return 1;; esac
}

ts()  { date '+%Y-%m-%d %H:%M:%S'; }
logln(){ mkdir -p "$STATE_DIR" 2>/dev/null; printf '%s %s\n' "$(ts)" "$*" >> "$LOG"; }

# ----------------------------------------------------------------------------- ui: animation layer
BAR_W=22
_SPIN=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
_BLK=('' ▏ ▎ ▍ ▌ ▋ ▊ ▉)     # sub-cell eighths; index 1..7 (0 unused)

_ui_animated() { [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "$DRY_RUN" != 1 ]; }

_human_kb() { # <kb> -> "512 KB" / "240 MB" / "1.5 GB"
  local kb="${1:-0}"
  if [ "$kb" -ge 1048576 ]; then
    printf '%d.%d GB' "$(( kb / 1048576 ))" "$(( (kb % 1048576) * 10 / 1048576 ))"
  elif [ "$kb" -ge 1024 ]; then
    printf '%d MB' "$(( kb / 1024 ))"
  else
    printf '%d KB' "$kb"
  fi
}

_spin_frame() { printf '%s' "${_SPIN[$(( ${1:-0} % 10 ))]}"; }

_rep() { # <char> <count> -> char repeated count times.
  # MUST use printf-pad + substitution, NOT a `out="$out█"` loop: bash 3.2 under a
  # UTF-8 locale corrupts iterative multibyte self-append (verified — produces garbage).
  local ch="${1:-}" n="${2:-0}"; [ "$n" -le 0 ] && return 0
  local s; s="$(printf "%${n}s" "")"; printf '%s' "${s// /$ch}"
}

_bar_str() { # <pct> <width> -> "████▏░░░"  (plain; caller adds color)
  local pct="${1:-0}" w="${2:-$BAR_W}"
  [ "$pct" -gt 100 ] && pct=100; [ "$pct" -lt 0 ] && pct=0
  local eighths=$(( pct * w * 8 / 100 )) full=$(( pct * w * 8 / 100 / 8 )) part mid="" rest
  part=$(( eighths % 8 )); rest=$(( w - full ))
  if [ "$part" -gt 0 ] && [ "$full" -lt "$w" ]; then mid="${_BLK[$part]}"; rest=$(( rest - 1 )); fi
  printf '%s%s%s' "$(_rep █ "$full")" "$mid" "$(_rep ░ "$rest")"
}

# teal (#2dd4bf) → emerald (#34d399) truecolor gradient for the bar fill; flat fallback off-truecolor
_TRUECOLOR=0; case "${COLORTERM:-}" in *truecolor*|*24bit*) _TRUECOLOR=1;; esac
_GRAD=(); TRACK=""
_build_grad() { # precompute per-cell 24-bit fg codes (teal→emerald) + a faint track colour
  [ "$_TRUECOLOR" = 1 ] || return 0
  local i=0 r g b c d=$(( BAR_W > 1 ? BAR_W - 1 : 1 ))
  while [ "$i" -lt "$BAR_W" ]; do
    r=$(( 45 + 7 * i / d )); g=$(( 212 - i / d )); b=$(( 191 - 38 * i / d ))
    printf -v c '\033[38;2;%d;%d;%dm' "$r" "$g" "$b"; _GRAD[$i]="$c"; i=$(( i + 1 ))
  done
  printf -v TRACK '\033[38;2;74;80;90m'
}
_build_grad

_bar_grad() { # <pct> <width> -> gradient-filled bar (teal→emerald) + faint track; truecolor only
  local pct="${1:-0}" w="${2:-$BAR_W}"
  [ "$pct" -gt 100 ] && pct=100; [ "$pct" -lt 0 ] && pct=0
  local eighths=$(( pct * w * 8 / 100 )) full=$(( pct * w * 8 / 100 / 8 )) part out="" c=0
  part=$(( eighths % 8 ))
  while [ "$c" -lt "$full" ]; do out="$out${_GRAD[$c]}█"; c=$(( c + 1 )); done
  if [ "$part" -gt 0 ] && [ "$full" -lt "$w" ]; then out="$out${_GRAD[$c]}${_BLK[$part]}"; c=$(( c + 1 )); fi
  local rest=$(( w - c )); [ "$rest" -gt 0 ] && out="$out${TRACK}$(_rep ░ "$rest")"
  printf '%s%s' "$out" "$R"
}

ROW_LABEL=(); ROW_STATE=(); ROW_PCT=(); ROW_TOTKB=(); ROW_DSTKB=()
ROWS_H=0; SHOW_AGG=0; ROW_CUR=-1; FRAME=0

_du_kb() { local k; k="$(du -sk "$1" 2>/dev/null | awk 'NR==1{print $1}')"; echo "${k:-0}"; }
_in_block() { _ui_animated && [ "$ROW_CUR" -ge 0 ]; }

_rows_begin() { ROW_LABEL=(); ROW_STATE=(); ROW_PCT=(); ROW_TOTKB=(); ROW_DSTKB=(); SHOW_AGG="${1:-0}"; ROWS_H=0; }
_rows_add()   { ROW_LABEL+=("$1"); ROW_TOTKB+=("${2:-0}"); ROW_DSTKB+=(0); ROW_PCT+=(0); ROW_STATE+=(queued); }

_row_line() { # <idx>
  local i="$1" glyph gcls barcls barstr size
  case "${ROW_STATE[$i]}" in
    queued)   glyph='○'; gcls="$DIM";  barcls="$DIM" ;;
    done)     glyph='✓'; gcls="$GRN";  barcls="$GRN" ;;
    failed)   glyph='✗'; gcls="$RED";  barcls="$RED" ;;
    verifying)glyph="$(_spin_frame $FRAME)"; gcls="$CYN"; barcls="$CYN" ;;
    *)        glyph="$(_spin_frame $FRAME)"; gcls="$CYN"; barcls="$CYN" ;;
  esac
  # gradient fill for live/done rows when truecolor is available; flat elsewhere (queued/failed/no-truecolor)
  if [ "$_TRUECOLOR" = 1 ] && [ "${ROW_STATE[$i]}" != queued ] && [ "${ROW_STATE[$i]}" != failed ]; then
    barstr="$(_bar_grad "${ROW_PCT[$i]}" "$BAR_W")"
  else
    barstr="${barcls}$(_bar_str "${ROW_PCT[$i]}" "$BAR_W")${R}"
  fi
  if [ "${ROW_STATE[$i]}" = queued ]; then size="queued"
  elif [ "${ROW_STATE[$i]}" = done ]; then size="$(_human_kb "${ROW_TOTKB[$i]}")"
  else size="$(_human_kb "${ROW_DSTKB[$i]}") / $(_human_kb "${ROW_TOTKB[$i]}")"; fi
  printf '  %s%s%s %s%-12s%s %s  %s%3d%%%s   %s%s%s' \
    "$gcls" "$glyph" "$R" "$B" "${ROW_LABEL[$i]}" "$R" \
    "$barstr" \
    "$gcls" "${ROW_PCT[$i]}" "$R" "$DIM" "$size" "$R"
}
_agg_line() {
  local i=0 done=0 tot=0
  while [ "$i" -lt "${#ROW_TOTKB[@]}" ]; do
    tot=$(( tot + ROW_TOTKB[i] )); done=$(( done + ROW_TOTKB[i] * ROW_PCT[i] / 100 )); i=$(( i + 1 ))
  done
  printf '  %s▸%s %s%s of %s · verified byte-for-byte before removal%s' \
    "$CYN" "$R" "$DIM" "$(_human_kb "$done")" "$(_human_kb "$tot")" "$R"
}

_rows_paint() {
  _ui_animated || return 0
  local i=0
  while [ "$i" -lt "${#ROW_LABEL[@]}" ]; do _row_line "$i"; printf '\n'; i=$(( i + 1 )); done
  [ "$SHOW_AGG" = 1 ] && { _agg_line; printf '\n'; }
  ROWS_H=$(( ${#ROW_LABEL[@]} + ( SHOW_AGG == 1 ? 1 : 0 ) ))
}
_rows_update() {
  _ui_animated || return 0
  FRAME=$(( FRAME + 1 ))
  tput cuu "$ROWS_H"
  local i=0
  while [ "$i" -lt "${#ROW_LABEL[@]}" ]; do printf '\r'; tput el; _row_line "$i"; printf '\n'; i=$(( i + 1 )); done
  [ "$SHOW_AGG" = 1 ] && { printf '\r'; tput el; _agg_line; printf '\n'; }
}
_rows_state() { _in_block || return 0; ROW_STATE[$ROW_CUR]="$1"; _rows_update; }
_rows_done()  { _in_block || return 0; ROW_STATE[$ROW_CUR]=done; ROW_PCT[$ROW_CUR]=100; _rows_update; }
_rows_fail()  { _in_block || return 0; ROW_STATE[$ROW_CUR]=failed; _rows_update; }

_run_poll() { # <idx> <dst> -- cmd... : run the copy cmd in bg, poll dst size -> row pct. Plain cmd off-TTY.
  local idx="$1" dst="$2"; shift 2; [ "${1:-}" = "--" ] && shift
  if ! _ui_animated || [ "$idx" -lt 0 ]; then "$@"; return $?; fi
  local tot="${ROW_TOTKB[$idx]}" d p
  ROW_STATE[$idx]=copying
  "$@" & local pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    d="$(_du_kb "$dst")"; ROW_DSTKB[$idx]="$d"
    p=0; [ "$tot" -gt 0 ] && p=$(( d * 100 / tot )); [ "$p" -gt 99 ] && p=99
    [ "$p" -lt "${ROW_PCT[$idx]}" ] && p="${ROW_PCT[$idx]}"   # monotonic
    ROW_PCT[$idx]="$p"; _rows_update; sleep 0.2
  done
  wait "$pid"; return $?
}

spin() { # spin "label" -- cmd...
  local label="$1"; shift; [ "${1:-}" = "--" ] && shift
  if ! _ui_animated; then "$@"; return $?; fi
  "$@" & local pid=$! i=0
  tput civis 2>/dev/null
  trap 'tput cnorm 2>/dev/null' INT TERM        # restore cursor if the user Ctrl-Cs mid-spin
  while kill -0 "$pid" 2>/dev/null; do printf '\r  %s%s%s %s' "$CYN" "$(_spin_frame $i)" "$R" "$label …"; tput el; i=$(( i + 1 )); sleep 0.08; done
  wait "$pid"; local st=$?
  trap - INT TERM
  tput cnorm 2>/dev/null
  printf '\r'; tput el
  if [ "$st" = 0 ]; then ok "$label"; else err "$label"; fi
  return $st
}

# ----------------------------------------------------------------------------- config
DRIVE=""
FOLDERS=()
MIRROR_DEST="$HOME/.limpet/mirror"
AUTO_UPDATE=0
GUARD_INTERVAL=0   # 0 = event-driven only (WatchPaths). >0 = also poll every N seconds (belt-and-suspenders).

load_config() { [ -f "$CONFIG" ] && . "$CONFIG"; }
require_config() {
  load_config
  [ -n "$DRIVE" ] || die "limpet is not set up yet. Run: ${B}limpet setup${R}"
}
save_config() {
  mkdir -p "$CONFIG_DIR"
  {
    echo "# limpet config — edit with care, or re-run \`limpet setup\`"
    printf 'DRIVE=%q\n' "$DRIVE"
    printf 'FOLDERS=('; for f in ${FOLDERS[@]+"${FOLDERS[@]}"}; do printf '%q ' "$f"; done; printf ')\n'
    printf 'MIRROR_DEST=%q\n' "$MIRROR_DEST"
    printf 'AUTO_UPDATE=%q\n' "$AUTO_UPDATE"
    printf 'GUARD_INTERVAL=%q\n' "$GUARD_INTERVAL"
  } > "$CONFIG"
  [ -f "$MIRROR_LIST" ] || cat > "$MIRROR_LIST" <<EOF
# limpet — paths under the drive to keep mirrored to a local fallback copy,
# so important files stay readable when the drive is unplugged.
# One path per line, RELATIVE to the drive root. '#' = comment.
EOF
  [ -f "$ENV_CONF" ] || seed_env_conf
}

seed_env_conf() {
  mkdir -p "$CONFIG_DIR"
  cat > "$ENV_CONF" <<'EOF'
# limpet env — environment variables to point at the drive when it is connected.
#   VAR = relative/path/under/drive   → export VAR="$DRIVE/<path>" while the drive is present.
# When the drive is unplugged the variable is UNSET, so tools fall back to their internal-disk defaults.
# '#' = comment. Edits take effect in the next shell. Manage with:
#   limpet env              show current mappings + state
#   limpet env add VAR path add/replace a mapping
#   limpet env rm VAR       remove a mapping
#
# Common build caches — uncomment the ones you use (adjust paths to your drive layout):
# GOCACHE          = Caches/go-build
# GOMODCACHE       = Caches/go-mod
# GRADLE_USER_HOME = Caches/gradle
# NPM_CONFIG_CACHE = Caches/npm
# ANDROID_HOME     = Android/sdk
# ANDROID_SDK_ROOT = Android/sdk
EOF
}

drive_present() {
  # A drive is "present" only if it's a REAL, currently-mounted volume — not a hollow
  # /Volumes/<name> mountpoint left behind by an unclean eject (which still passes `[ -d ]`
  # but has no files, silently breaking reads/dev-servers). For real /Volumes/* drives we
  # require a live `mount` entry; a non-/Volumes path (the test harness) falls back to `[ -d ]`.
  [ -n "$DRIVE" ] && [ -d "$DRIVE" ] || return 1
  case "$DRIVE" in
    # NB: capture `mount` first — `mount | grep -q` would SIGPIPE the producer and, under
    # `set -o pipefail`, return non-zero even when mounted (a false "unplugged" → spurious failover).
    /Volumes/*) case "$(mount 2>/dev/null)" in *" on $DRIVE ("*) return 0;; *) return 1;; esac ;;
    *)          return 0 ;;
  esac
}

# ----------------------------------------------------------------------------- lock
with_lock() { # with_lock <name> <command...>
  local name="$1"; shift
  local lock="$STATE_DIR/$name.lock.d"
  mkdir -p "$STATE_DIR" 2>/dev/null
  [ -d "$lock" ] && [ -n "$(find "$lock" -maxdepth 0 -mmin +2 2>/dev/null)" ] && rmdir "$lock" 2>/dev/null
  if ! mkdir "$lock" 2>/dev/null; then logln "[$name] skip: another instance running"; return 0; fi
  trap 'rmdir "'"$lock"'" 2>/dev/null' RETURN
  "$@"
}

# ----------------------------------------------------------------------------- verified move + link
_manifest() { # sha of every file/symlink path+size (ignores volatile macOS sidecars)
  ( cd "$1" 2>/dev/null && find . \( -type f -o -type l \) ! -name .DS_Store ! -name '._*' -print0 \
      | LC_ALL=C sort -z | xargs -0 stat -f '%N|%z' 2>/dev/null ) | shasum | awk '{print $1}'
}
verify_copy() { # verify_copy <src> <dst>  -> 0 if identical
  local s="$1" d="$2"
  if [ -d "$s" ]; then [ -n "$(_manifest "$s")" ] && [ "$(_manifest "$s")" = "$(_manifest "$d")" ]
  else [ "$(shasum "$s" | awk '{print $1}')" = "$(shasum "$d" | awk '{print $1}')" ]; fi
}

# move_to_drive <abs-src> <abs-dst> [label] : ditto-copy, verify, then delete src + symlink it to dst
move_to_drive() {
  local src="$1" dst="$2" label="${3:-$(basename "$dst")}"
  [ -L "$src" ] && { _in_block && { _rows_done; return 0; }; info "already a symlink: ${DIM}$src${R}"; return 0; }
  [ -e "$src" ] || { ln -s "$dst" "$src"; return 0; }
  local standalone=0
  if [ -e "$dst" ] && [ ! -L "$dst" ]; then
    _in_block || warn "destination already exists, verifying instead of copying: $dst"
  else
    if [ "$DRY_RUN" = 1 ]; then say "${DIM}[dry-run] ditto '$src' '$dst'${R}"; return 0; fi
    if _ui_animated && [ "$ROW_CUR" -lt 0 ]; then _rows_begin 0; _rows_add "$label" "$(_du_kb "$src")"; _rows_paint; ROW_CUR=0; standalone=1; fi
    _run_poll "$ROW_CUR" "$dst" -- ditto "$src" "$dst" || { _rows_fail; err "copy failed: $src"; [ "$standalone" = 1 ] && ROW_CUR=-1; return 1; }
  fi
  [ "$DRY_RUN" = 1 ] && { say "${DIM}[dry-run] verify + replace '$src' with symlink${R}"; return 0; }
  _rows_state verifying
  verify_copy "$src" "$dst" || { _rows_fail; err "verify FAILED — leaving original intact: $src"; [ "$standalone" = 1 ] && ROW_CUR=-1; return 1; }
  chmod -N "$src" 2>/dev/null
  rm -rf "$src" && ln -s "$dst" "$src" || { _rows_fail; err "swap failed (data is safe at $dst)"; [ "$standalone" = 1 ] && ROW_CUR=-1; return 1; }
  _rows_done
  [ "$standalone" = 1 ] && ROW_CUR=-1
  return 0
}

# ----------------------------------------------------------------------------- the guard (failover/failback)
_guard_one() {
  local name="$1" local_path="$HOME/$1" x9="$DRIVE/$1"
  if drive_present; then
    mkdir -p "$x9" 2>/dev/null
    if [ -L "$local_path" ]; then
      [ "$(readlink "$local_path")" != "$x9" ] && { ln -sfn "$x9" "$local_path"; logln "[guard] fixed $name link"; }
      return 0
    fi
    if [ -e "$local_path" ]; then                     # real local folder from a failover -> merge back
      logln "[guard] failback $name: merging local files back to drive"
      local f base new; shopt -s dotglob nullglob
      for f in "$local_path"/*; do
        base="$(basename "$f")"; [ "$base" = ".DS_Store" ] && { rm -f "$f"; continue; }
        if [ -e "$x9/$base" ]; then new="${base}.local-$(date +%Y%m%d-%H%M%S)"; mv "$f" "$x9/$new" && logln "[guard]   kept-both: $base -> $new"
        else mv "$f" "$x9/" 2>/dev/null || logln "[guard]   could not move $base (drive not writable here)"; fi
      done
      shopt -u dotglob nullglob
      chmod -N "$local_path" 2>/dev/null
      if rmdir "$local_path" 2>/dev/null; then ln -sfn "$x9" "$local_path"; logln "[guard] failback $name complete"
      else logln "[guard] failback $name: local dir not empty (drive not writable here) — left for terminal run"; fi
      return 0
    fi
    ln -sfn "$x9" "$local_path"; logln "[guard] created $name link"
  else                                                # drive gone -> become a real local folder
    if [ -L "$local_path" ]; then rm -f "$local_path" && mkdir -p "$local_path" && logln "[guard] failover $name -> local folder"
    elif [ ! -e "$local_path" ]; then mkdir -p "$local_path"; fi
  fi
}
run_guard() {
  load_config; [ -n "$DRIVE" ] || exit 0
  logln "[guard] run: drive $(drive_present && echo PRESENT || echo ABSENT)"
  local f; for f in ${FOLDERS[@]+"${FOLDERS[@]}"}; do _guard_one "$f"; done
}

# ----------------------------------------------------------------------------- the mirror
run_mirror() {
  load_config; [ -n "$DRIVE" ] || exit 0
  drive_present || { logln "[mirror] drive absent — keeping existing mirror"; return 0; }
  [ -f "$MIRROR_LIST" ] || return 0
  mkdir -p "$MIRROR_DEST"
  local line src dst n=0 entries=()
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"; case "$line" in ''|\#*) continue;; esac
    [ -e "$DRIVE/$line" ] || { logln "[mirror] skip missing: $line"; continue; }
    entries+=("$line")
  done < "$MIRROR_LIST"
  [ "${#entries[@]}" -eq 0 ] && { logln "[mirror] done (0 mirrored)"; return 0; }

  if _ui_animated; then title "Mirroring ${#entries[@]} path(s) → $MIRROR_DEST"; _rows_begin 0
  for line in "${entries[@]}"; do _rows_add "$line" "$(_du_kb "$DRIVE/$line")"; done; _rows_paint; fi

  local _i=0
  for line in "${entries[@]}"; do
    src="$DRIVE/$line"; dst="$MIRROR_DEST/$line"; mkdir -p "$(dirname "$dst")"
    if _ui_animated; then ROW_CUR=$_i; else ROW_CUR=-1; fi   # NB: don't put _ui_animated in $(...) — [ -t 1 ] is false in a subshell pipe
    if [ -d "$src" ]; then mkdir -p "$dst"; _run_poll "$ROW_CUR" "$dst" -- rsync -a --delete "$src/" "$dst/" 2>>"$LOG" && { n=$((n+1)); _rows_done; } || _rows_fail
    else _run_poll "$ROW_CUR" "$dst" -- rsync -a "$src" "$dst" 2>>"$LOG" && { n=$((n+1)); _rows_done; } || _rows_fail; fi
    _i=$(( _i + 1 ))
  done
  ROW_CUR=-1
  logln "[mirror] done ($n mirrored)"
}

# ----------------------------------------------------------------------------- env offload (build caches)
# Point env-vars (GOCACHE, GRADLE_USER_HOME, …) at the drive when connected; unset when unplugged so
# tools fall back to internal-disk defaults. Config is the source of truth; the shell rc block just runs
# `limpet env --shell` at startup. This path must stay side-effect-free and fast — it runs in every shell.
_trim() { local s="$1"; s="${s#"${s%%[![:space:]]*}"}"; s="${s%"${s##*[![:space:]]}"}"; printf '%s' "$s"; }
_env_valid_name() { case "$1" in [A-Za-z_]*) [ -z "${1//[A-Za-z0-9_]/}" ];; *) return 1;; esac; }

# _env_each <callback>: invoke `callback VAR RELPATH` for every active (uncommented) mapping in env.conf.
_env_each() {
  local cb="$1"; [ -f "$ENV_CONF" ] || return 0
  local line var val
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    case "$(_trim "$line")" in ''|\#*) continue;; esac        # blank / comment (even if indented)
    case "$line" in *=*) ;; *) continue;; esac
    var="$(_trim "${line%%=*}")"; val="$(_trim "${line#*=}")"
    # env.conf is hand-editable and its output is eval'd in every shell — only ever emit a real
    # shell identifier. A typo'd or malicious name (`MY VAR`, `x$(…)`) is skipped, never eval'd.
    [ -n "$val" ] && _env_valid_name "$var" && "$cb" "$var" "$val"
  done < "$ENV_CONF"
}
# report mapping-shaped lines that were skipped as malformed, so `env`/`doctor` can flag a silent typo
_env_malformed() {
  [ -f "$ENV_CONF" ] || return 0
  local line t var
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"; t="$(_trim "$line")"
    case "$t" in ''|\#*) continue;; esac
    case "$line" in *=*) ;; *) continue;; esac
    var="$(_trim "${line%%=*}")"
    _env_valid_name "$var" || printf '  %s\n' "$t"
  done < "$ENV_CONF"
}
_env_emit_export() { printf 'export %s=%q\n' "$1" "$DRIVE/$2"; }
_env_emit_unset()  { printf 'unset %s\n' "$1"; }
__env_n=0; _env_bump() { __env_n=$(( __env_n + 1 )); }
_env_has_active() { __env_n=0; _env_each _env_bump; [ "$__env_n" -gt 0 ]; }

# machine output for `eval` in the shell rc — silent unless there is something to say
env_shell() {
  load_config
  [ -n "$DRIVE" ] || return 0
  [ -f "$ENV_CONF" ] || return 0
  if drive_present; then _env_each _env_emit_export; else _env_each _env_emit_unset; fi
}

_env_show_row() { # used by `limpet env` and `limpet status`
  local var="$1" tgt="$DRIVE/$2"
  if drive_present && [ -e "$tgt" ]; then printf '  %s✓%s %-16s → %s\n' "$GRN" "$R" "$var" "$tgt"
  elif drive_present;               then printf '  %s•%s %-16s → %s %s(not created on drive yet)%s\n' "$BLU" "$R" "$var" "$tgt" "$DIM" "$R"
  else                                   printf '  %s✗%s %-16s → %s %s(drive unplugged — unset)%s\n' "$YEL" "$R" "$var" "$tgt" "$DIM" "$R"; fi
}
__env_jfirst=1
_env_json_row() {
  local active=false; drive_present && [ -e "$DRIVE/$2" ] && active=true
  [ "$__env_jfirst" = 1 ] || printf ','; __env_jfirst=0
  printf '{"name":"%s","target":"%s","active":%s}' "$1" "$DRIVE/$2" "$active"
}

_env_add() {
  local var="${1:-}" path="${2:-}"
  _env_valid_name "$var" || die "invalid env var name: '${var}'  (letters, digits, underscore; not starting with a digit)"
  [ -n "$path" ] || die "usage: limpet env add VAR relative/path-under-drive"
  load_config; mkdir -p "$CONFIG_DIR"; [ -f "$ENV_CONF" ] || seed_env_conf
  local tmp; tmp="$(mktemp)"
  # only replace env.conf if the rewrite fully succeeds — never clobber it with a partial/empty temp
  if awk -v v="$var" '{ s=$0; sub(/^[ \t]+/,"",s)
      if (s ~ /^#/ || s=="") { print; next }
      key=s; sub(/[ \t]*=.*/,"",key); if (key==v) next; print }' "$ENV_CONF" > "$tmp" \
     && printf '%-16s = %s\n' "$var" "$path" >> "$tmp" && mv "$tmp" "$ENV_CONF"; then
    ok "env: ${B}$var${R} → ${DIM}drive:${R}$path  ${DIM}(open a new shell to apply)${R}"
  else
    rm -f "$tmp"; die "could not update $ENV_CONF"
  fi
}
_env_rm() {
  local var="${1:-}"; [ -n "$var" ] || die "usage: limpet env rm VAR"
  [ -f "$ENV_CONF" ] || return 0
  local tmp; tmp="$(mktemp)"
  if awk -v v="$var" '{ s=$0; sub(/^[ \t]+/,"",s)
      if (s ~ /^#/ || s=="") { print; next }
      key=s; sub(/[ \t]*=.*/,"",key); if (key==v) next; print }' "$ENV_CONF" > "$tmp" && mv "$tmp" "$ENV_CONF"; then
    ok "env: removed ${B}$var${R}  ${DIM}(open a new shell to apply)${R}"
  else
    rm -f "$tmp"; die "could not update $ENV_CONF"
  fi
}
_env_show() {
  load_config
  [ -n "$DRIVE" ] || die "not set up — run: ${B}limpet setup${R}"
  title "env offload → $DRIVE"
  say "drive:   $( drive_present && printf '%sconnected%s' "$GRN" "$R" || printf '%sUNPLUGGED%s' "$YEL" "$R" )"
  hr
  if [ -f "$ENV_CONF" ] && _env_has_active; then
    _env_each _env_show_row
    grep -q "$ENV_BEGIN" "$HOME/.zshrc" 2>/dev/null || grep -q "$ENV_BEGIN" "$HOME/.bashrc" 2>/dev/null \
      || { hr; warn "shell hook missing — run ${B}limpet setup${R} to (re)install it, or vars won't apply in new shells"; }
  else
    say "  ${DIM}no active mappings — add one, e.g.:${R}  ${B}limpet env add GOCACHE Caches/go-build${R}"
  fi
  local bad; bad="$(_env_malformed)"
  [ -n "$bad" ] && { hr; warn "ignored malformed line(s) in env.conf — fix with ${B}limpet env edit${R}:"; printf '%s\n' "$bad"; }
}
cmd_env() {
  case "${1:-show}" in
    --shell)     env_shell;;
    add)         shift; _env_add "$@";;
    rm|remove)   shift; _env_rm "$@";;
    edit)        load_config; mkdir -p "$CONFIG_DIR"; [ -f "$ENV_CONF" ] || seed_env_conf; "${EDITOR:-nano}" "$ENV_CONF";;
    show|"")     _env_show;;
    *)           die "usage: limpet env [--shell | add VAR path | rm VAR | edit]";;
  esac
}

# ----------------------------------------------------------------------------- agent + shell hook
HOOK_BEGIN="# >>> limpet self-heal >>>"
HOOK_END="# <<< limpet self-heal <<<"
ENV_BEGIN="# >>> limpet env >>>"
ENV_END="# <<< limpet env <<<"

install_agent() {
  mkdir -p "$(dirname "$PLIST")"
  local _interval_xml=""
  [ "${GUARD_INTERVAL:-0}" -gt 0 ] 2>/dev/null && _interval_xml="  <key>StartInterval</key><integer>$GUARD_INTERVAL</integer>"$'\n'
  cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key><array><string>$SELF</string><string>__guard</string></array>
  <key>RunAtLoad</key><true/>
  <key>WatchPaths</key><array><string>/Volumes</string></array>
${_interval_xml}  <key>StandardOutPath</key><string>$STATE_DIR/agent.out</string>
  <key>StandardErrorPath</key><string>$STATE_DIR/agent.err</string>
</dict></plist>
EOF
  launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
  launchctl bootstrap "gui/$(id -u)" "$PLIST" 2>/dev/null || launchctl load -w "$PLIST" 2>/dev/null || true
}
uninstall_agent() {
  launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || launchctl unload "$PLIST" 2>/dev/null || true
  rm -f "$PLIST"
}
# Is the guard registered? Capture `launchctl list` first — `launchctl list | grep -q` would
# SIGPIPE the (large) producer and, under `set -o pipefail`, intermittently report a false
# "not loaded" (racy, worse the more launchd jobs you have). No pipe here = deterministic.
_agent_loaded() { case "$(launchctl list 2>/dev/null)" in *"$LABEL"*) return 0;; esac; return 1; }

shell_rc() { # echo the rc files that exist
  for rc in "$HOME/.zshrc" "$HOME/.bashrc"; do [ -f "$rc" ] && echo "$rc"; done
}
install_hook() {
  local rc; for rc in $(shell_rc); do
    if ! grep -q "$HOOK_BEGIN" "$rc" 2>/dev/null; then
      cat >> "$rc" <<EOF

$HOOK_BEGIN
# Runs the guard + mirror from your terminal (which has disk access), throttled.
if [ -n "\${PS1:-}" ] || [[ \$- == *i* ]]; then ( \
  _ls="$STATE_DIR"; mkdir -p "\$_ls" 2>/dev/null; _now=\$(date +%s); \
  if [ \$(( _now - \$(cat "\$_ls/guard.stamp" 2>/dev/null || echo 0) )) -ge 60 ]; then echo "\$_now" > "\$_ls/guard.stamp"; "$SELF" __guard >/dev/null 2>&1; fi; \
  if [ \$(( _now - \$(cat "\$_ls/mirror.stamp" 2>/dev/null || echo 0) )) -ge 3600 ]; then echo "\$_now" > "\$_ls/mirror.stamp"; "$SELF" __mirror >/dev/null 2>&1; fi; \
  "$SELF" __autoupdate >/dev/null 2>&1; "$SELF" __organize >/dev/null 2>&1 \
  ) &
fi
$HOOK_END
EOF
      ok "added self-heal hook to ${DIM}$rc${R}"
    fi
    if ! grep -q "$ENV_BEGIN" "$rc" 2>/dev/null; then
      cat >> "$rc" <<EOF

$ENV_BEGIN
# Point build-cache env-vars at the drive when connected (foreground: sets vars in THIS shell).
[ -x "$SELF" ] && eval "\$("$SELF" env --shell 2>/dev/null)"
$ENV_END
EOF
      ok "added env hook to ${DIM}$rc${R}"
    fi
  done
}
_strip_block() { # <rc> <begin> <end> <label> — remove one marked block, in place
  local rc="$1" b="$2" e="$3" label="$4"
  grep -q "$b" "$rc" 2>/dev/null || return 0
  awk -v b="$b" -v e="$e" '$0==b{skip=1} skip{ if($0==e) skip=0; next } {print}' "$rc" > "$rc.limpet.tmp" && mv "$rc.limpet.tmp" "$rc"
  ok "removed $label hook from ${DIM}$rc${R}"
}
uninstall_hook() {
  local rc; for rc in $(shell_rc); do
    [ -f "$rc" ] || continue
    _strip_block "$rc" "$HOOK_BEGIN" "$HOOK_END" "self-heal"
    _strip_block "$rc" "$ENV_BEGIN" "$ENV_END" "env"
  done
}

# ----------------------------------------------------------------------------- drive detection
list_external_drives() { # prints mounted volumes that look like real external disks
  local v
  for v in /Volumes/*; do
    [ -d "$v" ] || continue
    [ "$v" = "/Volumes/Macintosh HD" ] && continue
    [ -L "$v" ] && continue
    echo "$v"
  done
}

# ----------------------------------------------------------------------------- self-update (GitHub Releases)
_pick_max_semver() { grep -oE 'v?[0-9]+\.[0-9]+\.[0-9]+' | sed 's/^v//' | sort -t. -k1,1n -k2,2n -k3,3n | tail -1; }
_latest_version() {
  # Primary: the Releases API. Fallback: `git ls-remote` tags — works when api.github.com is
  # rate-limited or blocked (HTTP 403) on networks that still allow git egress (common on
  # corporate/VPN/shared-IP setups). The download hosts (github.com releases, raw) stay reachable,
  # so once we know the tag the update still applies.
  local v
  v="$(curl -fsSL --max-time 6 "https://api.github.com/repos/$REPO/releases/latest" 2>/dev/null | awk -F'"' '/"tag_name"/{print $4; exit}' | sed 's/^v//')"
  [ -n "$v" ] && { printf '%s' "$v"; return 0; }
  git ls-remote --tags --refs "https://github.com/$REPO.git" 2>/dev/null | _pick_max_semver
}
_ver_gt() { [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -t. -k1,1n -k2,2n -k3,3n | tail -1)" = "$1" ]; }
_do_update() {
  local v="$1" tmp; tmp="$(mktemp)"
  spin "downloading v$v" -- bash -c '
    curl -fsSL --max-time 30 "https://github.com/'"$REPO"'/releases/download/v'"$v"'/limpet" -o "'"$tmp"'" 2>/dev/null \
      || curl -fsSL --max-time 30 "https://raw.githubusercontent.com/'"$REPO"'/v'"$v"'/limpet" -o "'"$tmp"'" 2>/dev/null' || return 1
  /bin/bash -n "$tmp" || return 1
  chmod +x "$tmp"
  if [ -w "$SELF" ]; then mv "$tmp" "$SELF"; else sudo mv "$tmp" "$SELF" 2>/dev/null || mv "$tmp" "$SELF"; fi
}
cmd_update() {
  local check=0; [ "${1:-}" = "--check" ] && check=1
  info "current v$LIMPET_VERSION — checking $REPO …"
  local latest; latest="$(_latest_version)"
  [ -n "$latest" ] || die "couldn't reach GitHub releases (offline?)."
  if ! _ver_gt "$latest" "$LIMPET_VERSION"; then ok "already on the latest (v$LIMPET_VERSION)."; rm -f "$STATE_DIR/update-available"; return 0; fi
  warn "update available: v$LIMPET_VERSION → ${B}v$latest${R}"
  [ "$check" = 1 ] && { say "run ${B}limpet update${R} to install."; return 0; }
  confirm "install v$latest now?" || return 0
  _do_update "$latest" && { ok "updated to v$latest."; rm -f "$STATE_DIR/update-available"; } || die "update failed."
}
cmd_autoupdate() { # internal: daily check; auto-applies if AUTO_UPDATE=1, else records availability for a notice
  load_config; mkdir -p "$STATE_DIR"; local now; now=$(date +%s)
  [ $(( now - $(cat "$STATE_DIR/update-check.stamp" 2>/dev/null || echo 0) )) -ge 86400 ] || return 0
  echo "$now" > "$STATE_DIR/update-check.stamp"
  local latest; latest="$(_latest_version)"; [ -n "$latest" ] || return 0
  if _ver_gt "$latest" "$LIMPET_VERSION"; then
    if [ "${AUTO_UPDATE:-0}" = "1" ]; then _do_update "$latest" && logln "[update] auto-updated v$LIMPET_VERSION -> v$latest"; rm -f "$STATE_DIR/update-available"
    else echo "$latest" > "$STATE_DIR/update-available"; fi
  else rm -f "$STATE_DIR/update-available"; fi
}
_notice() { local a; a="$(cat "$STATE_DIR/update-available" 2>/dev/null)"; [ -n "$a" ] && _ver_gt "$a" "$LIMPET_VERSION" && [ -t 1 ] && warn "limpet ${B}v$a${R} is available — run ${B}limpet update${R}"; return 0; }

# ----------------------------------------------------------------------------- list
_is_managed() { [ "${#FOLDERS[@]}" -gt 0 ] || return 1; local b="${1#$HOME/}"; case " ${FOLDERS[*]} " in *" $b "*) return 0;; esac; return 1; }
cmd_list() {
  require_config
  title "managed folders → $DRIVE"
  local f
  for f in ${FOLDERS[@]+"${FOLDERS[@]}"}; do
    if [ -L "$HOME/$f" ]; then printf '  %s✓%s ~/%-12s → %s\n' "$GRN" "$R" "$f" "$(readlink "$HOME/$f")"
    elif [ -d "$HOME/$f" ]; then printf '  %s•%s ~/%-12s %s(local — failover mode)%s\n' "$BLU" "$R" "$f" "$DIM" "$R"
    else printf '  %s?%s ~/%-12s %s(missing)%s\n' "$YEL" "$R" "$f" "$DIM" "$R"; fi
  done
  title "other links into the drive ${DIM}(ad-hoc, made with \`limpet link\`)${R}"
  local found=0 l tg
  while IFS= read -r l; do
    _is_managed "$l" && continue
    tg="$(readlink "$l" 2>/dev/null)"; case "$tg" in "$DRIVE"/*) printf '  %s↪%s %s → %s\n' "$CYN" "$R" "${l/#$HOME/~}" "$tg"; found=1;; esac
  done < <(find "$HOME" -maxdepth 2 -type l 2>/dev/null)
  [ "$found" = 0 ] && say "  ${DIM}none${R}"
}

# ----------------------------------------------------------------------------- commands
cmd_setup() {
  local pre_drive="" pre_folders="" pre_mirror=""
  while [ $# -gt 0 ]; do case "$1" in
    --drive) pre_drive="$2"; shift 2;;
    --folders) pre_folders="$2"; shift 2;;
    --mirror) pre_mirror="$2"; shift 2;;
    --yes|-y) ASSUME_YES=1; shift;;
    --dry-run) DRY_RUN=1; shift;;
    *) die "unknown setup option: $1";;
  esac; done

  title "limpet setup"
  say "Make an external drive your primary storage, with automatic local failover."
  hr
  if [ -f "$CONFIG" ]; then
    load_config
    ok "Existing limpet setup detected — drive ${B}$DRIVE${R}, folders: ${B}${FOLDERS[*]+"${FOLDERS[*]}"}${R}"
    say "${DIM}Re-running is safe: already-linked folders are kept as-is (no re-copy).${R}"; hr
  fi

  # 1) drive
  if [ -n "$pre_drive" ]; then DRIVE="$pre_drive"
  else
    local drives=(); while IFS= read -r d; do drives+=("$d"); done < <(list_external_drives)
    [ "${#drives[@]}" -gt 0 ] || die "No external drive found under /Volumes. Plug one in and retry."
    say "${B}Which drive should be primary?${R}"
    local i=1; for d in "${drives[@]}"; do printf '  %s%d%s) %s\n' "$CYN" "$i" "$R" "$d"; i=$((i+1)); done
    printf '%s?%s pick a number: ' "$YEL" "$R"; local pick; read -r pick || true
    case "$pick" in ''|*[!0-9]*) die "not a number";; esac
    [ "$pick" -ge 1 ] && [ "$pick" -le "${#drives[@]}" ] || die "out of range"
    DRIVE="${drives[$((pick-1))]}"
  fi
  [ -d "$DRIVE" ] || die "drive not mounted: $DRIVE"
  ok "drive: ${B}$DRIVE${R}"

  # 2) folders
  if [ -n "$pre_folders" ]; then IFS=',' read -ra FOLDERS <<< "$pre_folders"
  else
    say ""; say "${B}Which home folders should live on the drive?${R} ${DIM}(comma-separated)${R}"
    printf '  %sdefault:%s Documents,Downloads,Desktop  — press Enter to accept: ' "$DIM" "$R"
    local fin; read -r fin || true
    [ -z "$fin" ] && fin="Documents,Downloads,Desktop"
    IFS=',' read -ra FOLDERS <<< "$fin"
  fi
  ok "folders: ${B}${FOLDERS[*]+"${FOLDERS[*]}"}${R}"

  [ -n "$pre_mirror" ] && { mkdir -p "$CONFIG_DIR"; printf '%s\n' "${pre_mirror//,/$'\n'}" >> "$MIRROR_LIST"; }

  # auto-update preference
  if [ "$ASSUME_YES" != 1 ]; then confirm "Check for limpet updates automatically?" && AUTO_UPDATE=1 || AUTO_UPDATE=0; fi

  # 3) confirm
  say ""; warn "This will MOVE each folder's contents onto $DRIVE (verified copy first), replace them with"
  warn "symlinks, and install a background guard + a terminal hook. Existing data is never deleted before"
  warn "its copy is byte-verified."
  confirm "Proceed?" || { say "aborted."; return 1; }

  # 4) do it
  hr
  local f
  if _ui_animated; then
    title "Moving your folders onto ${B}$DRIVE${R} …"
    _rows_begin 1
    for f in ${FOLDERS[@]+"${FOLDERS[@]}"}; do _rows_add "$f" "$(_du_kb "$HOME/$f")"; done
    _rows_paint
    local _i=0
    for f in ${FOLDERS[@]+"${FOLDERS[@]}"}; do
      ROW_CUR=$_i
      move_to_drive "$HOME/$f" "$DRIVE/$f" "$f" || true
      _i=$(( _i + 1 ))
    done
    ROW_CUR=-1
  else
    for f in ${FOLDERS[@]+"${FOLDERS[@]}"}; do
      info "linking ${B}$f${R} → $DRIVE/$f"
      move_to_drive "$HOME/$f" "$DRIVE/$f" "$f" && ok "$f is now on the drive" || err "$f failed (left intact)"
    done
  fi
  save_config
  [ "$DRY_RUN" = 1 ] || { install_agent; install_hook; }
  hr
  ok "${B}Setup complete.${R}"
  say "  • Background guard: ${GRN}active${R} (reacts to plug/unplug instantly)"
  say "  • Terminal hook: added (merges offline work back + mirrors). Open a new terminal to activate."
  say "  • Offload build caches too: ${B}limpet env add GOCACHE Caches/go-build${R} ${DIM}(see: limpet env)${R}"
  say "  • Check anytime with ${B}limpet status${R}, or ${B}limpet doctor${R}."
}

cmd_status() {
  load_config
  local json=0; [ "${1:-}" = "--json" ] && json=1
  [ -n "$DRIVE" ] || { [ "$json" = 1 ] && echo '{"setup":false}' || die "not set up — run: limpet setup"; return; }
  local present="false"; drive_present && present="true"
  local agent="false"; _agent_loaded && agent="true"
  if [ "$json" = 1 ]; then
    printf '{"setup":true,"drive":"%s","drive_present":%s,"agent_loaded":%s,"folders":[' "$DRIVE" "$present" "$agent"
    local first=1 f t st
    for f in ${FOLDERS[@]+"${FOLDERS[@]}"}; do
      [ -L "$HOME/$f" ] && st="symlink" || { [ -d "$HOME/$f" ] && st="local" || st="missing"; }
      t="$(readlink "$HOME/$f" 2>/dev/null)"
      [ "$first" = 1 ] || printf ','; first=0
      printf '{"name":"%s","state":"%s","target":"%s"}' "$f" "$st" "$t"
    done
    printf ']'
    printf ',"env":['; __env_jfirst=1; _env_each _env_json_row; printf ']'
    printf '}\n'; return
  fi
  title "limpet status"
  say "drive:   ${B}$DRIVE${R}  $( [ "$present" = true ] && printf '%sconnected%s' "$GRN" "$R" || printf '%sUNPLUGGED%s' "$YEL" "$R" )"
  say "guard:   $( [ "$agent" = true ] && printf '%sloaded%s' "$GRN" "$R" || printf '%snot loaded%s' "$RED" "$R" )"
  hr
  local f t
  for f in ${FOLDERS[@]+"${FOLDERS[@]}"}; do
    if [ -L "$HOME/$f" ]; then t="$(readlink "$HOME/$f")"; [ -e "$HOME/$f" ] && printf '  %s✓%s ~/%-10s → %s\n' "$GRN" "$R" "$f" "$t" || printf '  %s✗%s ~/%-10s → %s %s(broken — drive unplugged)%s\n' "$YEL" "$R" "$f" "$t" "$DIM" "$R"
    elif [ -d "$HOME/$f" ]; then printf '  %s•%s ~/%-10s %s(local folder — failover mode)%s\n' "$BLU" "$R" "$f" "$DIM" "$R"
    else printf '  %s?%s ~/%-10s %s(missing)%s\n' "$YEL" "$R" "$f" "$DIM" "$R"; fi
  done
  if [ -f "$ENV_CONF" ] && _env_has_active; then
    hr; say "${B}env offload${R} ${DIM}(build caches)${R}"
    _env_each _env_show_row
  fi
}

cmd_watch() {
  require_config
  if ! _ui_animated; then cmd_status; return 0; fi
  local H=$(( ${#FOLDERS[@]} + 4 )) first=1 f t present
  tput civis 2>/dev/null
  trap 'tput cnorm 2>/dev/null; printf "\n"; exit 0' INT TERM
  while :; do
    present=0; drive_present && present=1
    [ "$first" = 1 ] && first=0 || tput cuu "$H"
    # header
    printf '\r'; tput el
    if [ "$present" = 1 ]; then printf '  %s●%s %sX9%s   %sconnected%s   %s%s%s\n' "$CYN" "$R" "$B" "$R" "$CYN" "$R" "$DIM" "$DRIVE" "$R"
    else printf '  %s●%s %sX9%s   %sUNPLUGGED%s   %swas %s%s\n' "$YEL" "$R" "$B" "$R" "$YEL" "$R" "$DIM" "$DRIVE" "$R"; fi
    printf '\r'; tput el; printf '  %sguard%s   %s\n' "$DIM" "$R" "$(_agent_loaded && printf '%sloaded%s' "$GRN" "$R" || printf '%snot loaded%s' "$RED" "$R")"
    printf '\r'; tput el; printf '\n'
    for f in ${FOLDERS[@]+"${FOLDERS[@]}"}; do
      printf '\r'; tput el
      if [ -L "$HOME/$f" ]; then t="$(readlink "$HOME/$f")"
        if [ -e "$HOME/$f" ]; then printf '  %s✓%s %-12s %s→ %s%s\n' "$GRN" "$R" "~/$f" "$DIM" "$t" "$R"
        else printf '  %s✗%s %-12s %s→ %s (broken — drive unplugged)%s\n' "$YEL" "$R" "~/$f" "$DIM" "$t" "$R"; fi
      elif [ -d "$HOME/$f" ]; then printf '  %s•%s %-12s %slocal — failover mode%s\n' "$BLU" "$R" "~/$f" "$DIM" "$R"
      else printf '  %s?%s %-12s %smissing%s\n' "$YEL" "$R" "~/$f" "$DIM" "$R"; fi
    done
    printf '\r'; tput el; printf '  %spress Ctrl-C to quit · redraws on plug / unplug%s\n' "$DIM" "$R"
    sleep 0.5
  done
}

cmd_doctor() {
  require_config
  title "limpet doctor"
  local issues=0
  drive_present && ok "drive mounted: $DRIVE" || { warn "drive not mounted ($DRIVE) — folders are in failover mode"; }
  # hollow mountpoint: the dir exists but no volume is mounted there — this is the classic
  # "SSD unplugged uncleanly → apps/dev-servers see an empty tree and can't load files" trap.
  if [ -d "$DRIVE" ] && ! drive_present; then
    warn "'$DRIVE' exists but nothing is mounted there (hollow mountpoint)."
    warn "That silently breaks reads/serves. Failover has switched folders to local; remove the empty"
    warn "dir (${DIM}sudo rmdir '$DRIVE'${R}) or eject cleanly, then replug so the real volume returns."
    issues=$((issues+1))
  fi
  _agent_loaded && ok "guard agent loaded" || { warn "guard agent NOT loaded"; issues=$((issues+1)); confirm "reinstall the agent?" && { install_agent; ok "reinstalled"; }; }
  [ "${GUARD_INTERVAL:-0}" -gt 0 ] 2>/dev/null && ok "periodic reconcile: every ${GUARD_INTERVAL}s (missed-event safety net)"
  [ -x "$SELF" ] && ok "cli present: $SELF" || warn "cli path looks off: $SELF"
  # env hook present when there are active env mappings
  if [ -f "$ENV_CONF" ] && _env_has_active; then
    if grep -q "$ENV_BEGIN" "$HOME/.zshrc" 2>/dev/null || grep -q "$ENV_BEGIN" "$HOME/.bashrc" 2>/dev/null; then ok "env hook present"
    else warn "env mappings exist but the shell hook is missing (vars won't apply in new shells)"; issues=$((issues+1)); confirm "reinstall the shell hook?" && { install_hook; ok "reinstalled"; }; fi
  fi
  local _envbad; _envbad="$(_env_malformed)"
  [ -n "$_envbad" ] && { warn "env.conf has malformed line(s) (ignored — not exported); fix with ${B}limpet env edit${R}:"; printf '%s\n' "$_envbad" >&2; issues=$((issues+1)); }
  # drive-name drift gotcha (e.g. "/Volumes/X9 1")
  if ! drive_present && [ -n "$(ls -d "${DRIVE} "* 2>/dev/null)" ]; then
    warn "Your drive may have remounted under a different name (e.g. '${DRIVE} 1')."
    warn "Eject it cleanly and replug so it returns to '$DRIVE'."
    issues=$((issues+1))
  fi
  hr
  [ "$issues" = 0 ] && ok "all good." || warn "$issues issue(s) above."
}

cmd_link() { # limpet link <path>   (move any extra file/folder onto the drive + symlink)
  require_config; drive_present || die "drive not mounted"
  local p="${1:-}"; [ -n "$p" ] || die "usage: limpet link <path>"
  [ -e "$p" ] || die "no such path: $p"
  local abs; abs="$(cd "$(dirname "$p")" && pwd)/$(basename "$p")"
  case "$abs" in "$DRIVE"/*) die "already on the drive";; esac
  local dst="$DRIVE/$(basename "$abs")"
  [ -e "$dst" ] && die "destination exists: $dst"
  info "moving ${B}$abs${R} → $dst"
  move_to_drive "$abs" "$dst" "$(basename "$abs")" && ok "linked." || err "failed."
}
cmd_unlink() { # limpet unlink <path>  (bring a symlinked path back to local disk)
  local p="${1:-}"; [ -n "$p" ] || die "usage: limpet unlink <path>"
  [ -L "$p" ] || die "not a symlink: $p"
  require_config; drive_present || die "drive not mounted (needed to copy data back)"
  local tgt; tgt="$(readlink "$p")"
  [ "$DRY_RUN" = 1 ] && { say "${DIM}[dry-run] copy $tgt back to $p${R}"; return; }
  rm -f "$p"; ditto "$tgt" "$p" && ok "restored to local disk: $p" || err "failed"
}

cmd_sync() {
  require_config
  spin "failover / failback" -- with_lock guard run_guard
  with_lock mirror run_mirror
  ok "synced."
}

cmd_uninstall() {
  load_config
  title "limpet uninstall"
  warn "This removes the guard agent and the terminal hook."
  uninstall_agent; uninstall_hook
  if [ -n "$DRIVE" ] && confirm "Also turn the symlinked folders back into normal LOCAL folders (copies data back from the drive)?"; then
    drive_present || die "drive must be mounted to copy data back"
    local f; for f in ${FOLDERS[@]+"${FOLDERS[@]}"}; do [ -L "$HOME/$f" ] && { rm -f "$HOME/$f"; ditto "$DRIVE/$f" "$HOME/$f" && ok "$f restored locally"; }; done
  fi
  ok "limpet uninstalled. (config left at $CONFIG_DIR — delete it to fully reset.)"
}

# ----------------------------------------------------------------------------- organize (opt-in file sorter)
# Off by default. Sorts top-level files in watched folders into destinations by ordered ext→dest rules,
# only when a file is "safe" per the chosen mode. Keep-both on clash; every move logged for undo.
ORG_LOG="$STATE_DIR/organize.log"
ORGANIZE_ENABLED=0
ORGANIZE_MODE="aged-idle"      # quick | aged | aged-idle
ORGANIZE_IDLE_DAYS=7
ORGANIZE_QUICK_MINUTES=30
ORGANIZE_WATCH=(Downloads)
ORGANIZE_BY_TYPE=1
ORGANIZE_DEST_ROOT=""
ORGANIZE_SCHEDULE="daily"      # daily | hourly | manual

load_organize() { [ -f "$ORGANIZE_CONF" ] && . "$ORGANIZE_CONF"; return 0; }
save_organize() {
  mkdir -p "$CONFIG_DIR"
  {
    echo "# limpet organize — manage via \`limpet organize\` commands, or edit by hand."
    printf 'ORGANIZE_ENABLED=%q\n' "$ORGANIZE_ENABLED"
    printf 'ORGANIZE_MODE=%q\n' "$ORGANIZE_MODE"
    printf 'ORGANIZE_IDLE_DAYS=%q\n' "$ORGANIZE_IDLE_DAYS"
    printf 'ORGANIZE_QUICK_MINUTES=%q\n' "$ORGANIZE_QUICK_MINUTES"
    printf 'ORGANIZE_WATCH=('; for _w in ${ORGANIZE_WATCH[@]+"${ORGANIZE_WATCH[@]}"}; do printf '%q ' "$_w"; done; printf ')\n'
    printf 'ORGANIZE_BY_TYPE=%q\n' "$ORGANIZE_BY_TYPE"
    printf 'ORGANIZE_DEST_ROOT=%q\n' "$ORGANIZE_DEST_ROOT"
    printf 'ORGANIZE_SCHEDULE=%q\n' "$ORGANIZE_SCHEDULE"
  } > "$ORGANIZE_CONF"
  [ -f "$ORGANIZE_RULES" ] || seed_organize_rules
}
seed_organize_rules() {
  mkdir -p "$CONFIG_DIR"
  cat > "$ORGANIZE_RULES" <<'EOF'
# limpet organize rules — ORDERED, first match wins.   Format:  Category | ext,ext,... | destination
#   destination blank + ORGANIZE_BY_TYPE=1  →  <DEST_ROOT-or-watched-folder>/<Category>/  (auto by type)
#   destination set (absolute or ~/path)    →  that type goes exactly there.
# Reorder/edit freely (or use: limpet organize rule add|rm|list|edit).
Images       | jpg,jpeg,png,gif,heic,webp,svg,bmp,tiff,ico |
Documents    | pdf,doc,docx,txt,md,rtf,odt,pages            |
Spreadsheets | xls,xlsx,csv,numbers                         |
Presentations| ppt,pptx,key                                 |
Video        | mp4,mov,mkv,avi,webm,m4v                     |
Audio        | mp3,wav,flac,aac,m4a,ogg                     |
Archives     | zip,tar,gz,tgz,bz2,rar,7z                    |
Installers   | dmg,pkg                                      |
Code         | sh,py,js,ts,go,rs,c,h,cpp,json,yaml,yml      |
EOF
}

_org_valid_name() { case "$1" in [A-Za-z0-9]*) [ -z "${1//[A-Za-z0-9_-]/}" ];; *) return 1;; esac; }
# _org_each_rule <cb>: cb Category "ext,ext" Destination  (first-match ordering is the caller's job)
_org_each_rule() {
  local cb="$1"; [ -f "$ORGANIZE_RULES" ] || return 0
  local line cat rest exts dest
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    case "$(_trim "$line")" in ''|\#*) continue;; esac
    case "$line" in *\|*) ;; *) continue;; esac
    cat="$(_trim "${line%%|*}")"; rest="${line#*|}"; exts="$(_trim "${rest%%|*}")"
    case "$rest" in *\|*) dest="$(_trim "${rest#*|}")";; *) dest="";; esac
    [ -n "$cat" ] && [ -n "$exts" ] && _org_valid_name "$cat" && "$cb" "$cat" "$exts" "$dest"
  done < "$ORGANIZE_RULES"
}
__org_n=0; _org_bump() { __org_n=$(( __org_n + 1 )); }
_org_rule_count() { __org_n=0; _org_each_rule _org_bump; printf '%s' "$__org_n"; }

_org_ext() { local b="${1##*/}"; case "$b" in *.*) printf '%s' "${b##*.}" | tr 'A-Z' 'a-z';; *) printf '';; esac; }
_org_expand() { case "$1" in "~/"*) printf '%s/%s' "$HOME" "${1#~/}";; "~") printf '%s' "$HOME";; *) printf '%s' "$1";; esac; }

# is a top-level file safe to move under the current mode?
_org_eligible() {
  local f="$1" base="${1##*/}"
  [ -f "$f" ] || return 1
  [ -L "$f" ] && return 1
  case "$base" in .*) return 1;; *.crdownload|*.part|*.download|*.tmp|*.partial|*.opdownload) return 1;; esac
  local now mt age; now="$(date +%s)"; mt="$(stat -f %m "$f" 2>/dev/null)"; [ -n "$mt" ] || mt="$now"; age=$(( now - mt ))
  case "$ORGANIZE_MODE" in
    quick)          [ "$age" -ge $(( ${ORGANIZE_QUICK_MINUTES:-30} * 60 )) ] || return 1 ;;
    aged|aged-idle) [ "$age" -ge $(( ${ORGANIZE_IDLE_DAYS:-7} * 86400 )) ] || return 1 ;;
    *) return 1 ;;
  esac
  if [ "$ORGANIZE_MODE" = "aged-idle" ] && command -v lsof >/dev/null 2>&1; then
    lsof -- "$f" >/dev/null 2>&1 && return 1   # open by a process → not safe
  fi
  return 0
}

__org_hit_cat=""; __org_hit_dest=""; __org_target_ext=""
_org_matchcb() {
  [ -n "$__org_hit_cat" ] && return 0
  local cat="$1" exts="$2" dest="$3" e
  local IFS=','
  for e in $exts; do
    case "$(printf '%s' "$e" | tr -d ' ' | tr 'A-Z' 'a-z')" in
      "$__org_target_ext") __org_hit_cat="$cat"; __org_hit_dest="$dest"; return 0 ;;
    esac
  done
}
_org_match() {  # <file> → sets __org_hit_cat/__org_hit_dest; 0 if a rule matched
  __org_target_ext="$(_org_ext "$1")"; __org_hit_cat=""; __org_hit_dest=""
  [ -n "$__org_target_ext" ] || return 1
  _org_each_rule _org_matchcb
  [ -n "$__org_hit_cat" ]
}
_org_dest_for() {  # <cat> <rule-dest> <watched-abs> → prints dest dir, or empty to skip
  local cat="$1" dest="$2" watch="$3" root
  if [ -n "$dest" ]; then printf '%s' "$(_org_expand "$dest")"
  elif [ "${ORGANIZE_BY_TYPE:-1}" = 1 ]; then
    root="$(_org_expand "${ORGANIZE_DEST_ROOT:-$watch}")"; printf '%s/%s' "$root" "$cat"
  fi
}
_org_move() {  # <src> <dstdir> ; keep-both, append to move log under $RUNID
  local src="$1" dstdir="$2" base="${1##*/}" tgt stamp
  mkdir -p "$dstdir" 2>/dev/null || return 1
  tgt="$dstdir/$base"
  if [ -e "$tgt" ]; then stamp="$(date +%Y%m%d-%H%M%S)"; case "$base" in *.*) tgt="$dstdir/${base%.*}.$stamp.${base##*.}";; *) tgt="$dstdir/$base.$stamp";; esac; fi
  mv "$src" "$tgt" 2>/dev/null || return 1
  mkdir -p "$STATE_DIR" 2>/dev/null; printf '%s\t%s\t%s\n' "$RUNID" "$src" "$tgt" >> "$ORG_LOG"
}

# per-(category,dest) tally for the grouped report
_ORG_TCAT=(); _ORG_TDEST=(); _ORG_TCNT=()
_org_tally() {
  local i=0
  while [ "$i" -lt "${#_ORG_TCAT[@]}" ]; do
    if [ "${_ORG_TCAT[$i]}" = "$1" ] && [ "${_ORG_TDEST[$i]}" = "$2" ]; then _ORG_TCNT[$i]=$(( ${_ORG_TCNT[$i]} + 1 )); return 0; fi
    i=$(( i + 1 ))
  done
  _ORG_TCAT+=("$1"); _ORG_TDEST+=("$2"); _ORG_TCNT+=(1)
}
_org_report() {  # <action> <moved> <skipped> <unsorted>
  local action="$1" moved="$2" skipped="$3" unsorted="$4" i=0
  [ "$action" = run ] && title "organize — moved  ${DIM}(mode: $ORGANIZE_MODE)${R}" || title "organize — preview  ${DIM}(mode: $ORGANIZE_MODE)${R}"
  if [ "${#_ORG_TCAT[@]}" -eq 0 ]; then say "  ${DIM}nothing to organize${R}"
  else
    while [ "$i" -lt "${#_ORG_TCAT[@]}" ]; do
      printf '  %s→%s %s%-13s%s %s%s%s  %s%d files%s\n' "$CYN" "$R" "$B" "${_ORG_TCAT[$i]}" "$R" "$DIM" "${_ORG_TDEST[$i]/#$HOME/~}" "$R" "$GRN" "${_ORG_TCNT[$i]}" "$R"
      i=$(( i + 1 ))
    done
  fi
  hr
  [ "$action" = run ] && say "  ${B}moved $moved${R} · skipped $skipped · unsorted $unsorted" || say "  ${B}would move $moved${R} · skipped $skipped · unsorted $unsorted"
  if [ "$action" != run ] && [ "$moved" -gt 0 ]; then say "  ${DIM}run it:${R} ${B}limpet organize run${R}   ${DIM}undo after:${R} ${B}limpet organize undo${R}"; fi
  return 0
}
run_organize() {  # <preview|run>
  local action="${1:-preview}"
  load_config; load_organize
  RUNID="$(date +%s)"
  _ORG_TCAT=(); _ORG_TDEST=(); _ORG_TCNT=()
  local watch abswatch f dstdir moved=0 skipped=0 unsorted=0
  for watch in ${ORGANIZE_WATCH[@]+"${ORGANIZE_WATCH[@]}"}; do
    case "$watch" in /*) abswatch="$watch";; "~/"*) abswatch="$HOME/${watch#~/}";; *) abswatch="$HOME/$watch";; esac
    if [ ! -d "$abswatch" ]; then logln "[organize] skip missing/unplugged: $abswatch"; continue; fi
    for f in "$abswatch"/*; do
      [ -e "$f" ] || continue                     # empty dir → literal glob → skip
      [ -f "$f" ] || continue                     # top-level files only (no recurse)
      if ! _org_eligible "$f"; then skipped=$(( skipped + 1 )); continue; fi
      if ! _org_match "$f"; then unsorted=$(( unsorted + 1 )); continue; fi
      dstdir="$(_org_dest_for "$__org_hit_cat" "$__org_hit_dest" "$abswatch")"
      [ -n "$dstdir" ] || { unsorted=$(( unsorted + 1 )); continue; }
      case "$f" in "$dstdir"/*) continue;; esac   # already in its destination
      if [ "$action" = run ]; then
        _org_move "$f" "$dstdir" && { _org_tally "$__org_hit_cat" "$dstdir"; moved=$(( moved + 1 )); } || skipped=$(( skipped + 1 ))
      else
        _org_tally "$__org_hit_cat" "$dstdir"; moved=$(( moved + 1 ))
      fi
    done
  done
  logln "[organize] $action: moved=$moved skipped=$skipped unsorted=$unsorted"
  _org_report "$action" "$moved" "$skipped" "$unsorted"
}
run_organize_auto() {  # internal: called by the hook; gated on enabled + schedule throttle
  load_organize
  [ "${ORGANIZE_ENABLED:-0}" = 1 ] || return 0
  local interval=86400 now stamp="$STATE_DIR/organize.stamp"
  case "${ORGANIZE_SCHEDULE:-daily}" in manual) return 0;; hourly) interval=3600;; *) interval=86400;; esac
  mkdir -p "$STATE_DIR" 2>/dev/null; now="$(date +%s)"
  [ $(( now - $(cat "$stamp" 2>/dev/null || echo 0) )) -ge "$interval" ] || return 0
  echo "$now" > "$stamp"
  run_organize run >/dev/null 2>&1
}
_org_run_confirmed() {
  load_organize
  [ "$ASSUME_YES" = 1 ] || confirm "organize now — move eligible files?" || { say "aborted."; return 0; }
  run_organize run
}
cmd_organize_undo() {
  [ -f "$ORG_LOG" ] || { info "nothing to undo."; return 0; }
  local last; last="$(awk -F'\t' 'NF>=3{r=$1} END{print r}' "$ORG_LOG")"
  [ -n "$last" ] || { info "nothing to undo."; return 0; }
  [ "$ASSUME_YES" = 1 ] || confirm "undo the last organize run (move files back)?" || return 0
  local tmp restored=0 src dst sdir back b st; tmp="$(mktemp)"
  awk -F'\t' -v r="$last" '$1==r{print $2"\t"$3}' "$ORG_LOG" | tail -r > "$tmp"   # reverse order
  while IFS="$(printf '\t')" read -r src dst; do
    [ -n "$src" ] && [ -n "$dst" ] || continue
    [ -e "$dst" ] || continue
    sdir="$(dirname "$src")"; mkdir -p "$sdir" 2>/dev/null; back="$src"
    if [ -e "$back" ]; then b="${src##*/}"; st="$(date +%Y%m%d-%H%M%S)"; case "$b" in *.*) back="$sdir/${b%.*}.$st.${b##*.}";; *) back="$sdir/$b.$st";; esac; fi
    mv "$dst" "$back" 2>/dev/null && restored=$(( restored + 1 ))
  done < "$tmp"
  rm -f "$tmp"
  awk -F'\t' -v r="$last" '$1!=r' "$ORG_LOG" > "$ORG_LOG.tmp" 2>/dev/null && mv "$ORG_LOG.tmp" "$ORG_LOG"
  ok "undo complete — restored $restored file(s)."
}
cmd_organize_log() {
  [ -f "$ORG_LOG" ] || { say "  ${DIM}no moves logged yet${R}"; return 0; }
  title "organize — recent moves"
  local rid src dst
  tail -20 "$ORG_LOG" | while IFS="$(printf '\t')" read -r rid src dst; do
    [ -n "$src" ] || continue; printf '  %s → %s\n' "${src/#$HOME/~}" "${dst/#$HOME/~}"
  done
}
_org_dashboard() {
  load_config; load_organize
  local json=0; [ "${1:-}" = "--json" ] && json=1
  local en="false"; [ "${ORGANIZE_ENABLED:-0}" = 1 ] && en="true"
  local bt="false"; [ "${ORGANIZE_BY_TYPE:-1}" = 1 ] && bt="true"
  if [ "$json" = 1 ]; then
    printf '{"enabled":%s,"mode":"%s","idle_days":%s,"quick_minutes":%s,"by_type":%s,"schedule":"%s","rules":%s,"watch":[' \
      "$en" "$ORGANIZE_MODE" "${ORGANIZE_IDLE_DAYS:-7}" "${ORGANIZE_QUICK_MINUTES:-30}" "$bt" "$ORGANIZE_SCHEDULE" "$(_org_rule_count)"
    local first=1 w; for w in ${ORGANIZE_WATCH[@]+"${ORGANIZE_WATCH[@]}"}; do [ "$first" = 1 ] || printf ','; first=0; printf '"%s"' "$w"; done
    printf ']}\n'; return 0
  fi
  title "limpet organize"
  if [ "$en" = true ]; then say "status:  ${GRN}on${R}"; else say "status:  ${YEL}off${R}  ${DIM}(turn on: limpet organize enable)${R}"; fi
  say "mode:    ${B}$ORGANIZE_MODE${R}  ${DIM}(idle ${ORGANIZE_IDLE_DAYS}d · quick ${ORGANIZE_QUICK_MINUTES}m)${R}"
  say "watch:   ${B}$(for w in ${ORGANIZE_WATCH[@]+"${ORGANIZE_WATCH[@]}"}; do printf '%s ' "$w"; done)${R}"
  say "dests:   $( [ "$bt" = true ] && printf 'by type' || printf 'per-rule only' )  ${DIM}·${R}  schedule: ${B}$ORGANIZE_SCHEDULE${R}  ${DIM}·${R}  rules: ${B}$(_org_rule_count)${R}"
  hr
  say "  ${DIM}preview: ${R}${B}limpet organize preview${R}   ${DIM}setup: ${R}${B}limpet organize setup${R}"
  return 0
}
_org_rule_print() { printf '  %s%-13s%s %s   %s%s%s\n' "$B" "$1" "$R" "$2" "$DIM" "${3:-→ by type}" "$R"; }
_org_rule_add() {
  local cat="${1:-}" exts="${2:-}" dest="${3:-}"
  _org_valid_name "$cat" || die "invalid category (letters/digits/_/-): '${cat}'"
  [ -n "$exts" ] || die "usage: limpet organize rule add <Category> <ext,ext,...> [destination]"
  mkdir -p "$CONFIG_DIR"; [ -f "$ORGANIZE_RULES" ] || seed_organize_rules
  local tmp; tmp="$(mktemp)"
  if awk -F'|' -v c="$cat" '{s=$1; gsub(/^[ \t]+|[ \t]+$/,"",s); if(s==c) next; print}' "$ORGANIZE_RULES" > "$tmp"; then
    printf '%-12s | %s | %s\n' "$cat" "$exts" "$dest" >> "$tmp" && mv "$tmp" "$ORGANIZE_RULES" \
      && ok "rule: ${B}$cat${R} → ${dest:-by type}  [$exts]" && return 0
  fi
  rm -f "$tmp"; die "could not update rules"
}
_org_rule_rm() {
  local cat="${1:-}"; [ -n "$cat" ] || die "usage: limpet organize rule rm <Category>"
  [ -f "$ORGANIZE_RULES" ] || return 0
  local tmp; tmp="$(mktemp)"
  if awk -F'|' -v c="$cat" '{s=$1; gsub(/^[ \t]+|[ \t]+$/,"",s); if(s==c) next; print}' "$ORGANIZE_RULES" > "$tmp"; then
    mv "$tmp" "$ORGANIZE_RULES"; ok "removed rule: ${B}$cat${R}"
  else rm -f "$tmp"; die "could not update rules"; fi
}
organize_rule() {
  local op="${1:-list}"; shift 2>/dev/null || true
  case "$op" in
    list|"") title "organize rules ${DIM}(ordered · first match wins)${R}"; _org_each_rule _org_rule_print;;
    add)     _org_rule_add "$@";;
    rm)      _org_rule_rm "$@";;
    edit)    mkdir -p "$CONFIG_DIR"; [ -f "$ORGANIZE_RULES" ] || seed_organize_rules; "${EDITOR:-nano}" "$ORGANIZE_RULES";;
    *)       die "usage: limpet organize rule <list|add|rm|edit>";;
  esac
}
organize_watch() {
  load_organize; local op="${1:-list}"; shift 2>/dev/null || true
  local d="${1:-}" w new=()
  case "$op" in
    add)     [ -n "$d" ] || die "usage: limpet organize watch add <folder>"; ORGANIZE_WATCH+=("$d"); save_organize; ok "watching: ${B}$d${R}";;
    rm)      [ -n "$d" ] || die "usage: limpet organize watch rm <folder>"; for w in ${ORGANIZE_WATCH[@]+"${ORGANIZE_WATCH[@]}"}; do [ "$w" = "$d" ] || new+=("$w"); done; ORGANIZE_WATCH=(${new[@]+"${new[@]}"}); save_organize; ok "unwatched: ${B}$d${R}";;
    list|"") for w in ${ORGANIZE_WATCH[@]+"${ORGANIZE_WATCH[@]}"}; do say "  $w"; done;;
    *)       die "usage: limpet organize watch <add|rm|list> [folder]";;
  esac
}
organize_set_mode() {
  load_organize; local m="${1:-}"; shift 2>/dev/null || true
  case "$m" in quick|aged|aged-idle) ORGANIZE_MODE="$m";; *) die "usage: limpet organize mode <quick|aged|aged-idle> [--days N|--minutes N]";; esac
  while [ $# -gt 0 ]; do case "$1" in
    --days) case "${2:-}" in *[!0-9]*|'') die "days must be a number";; esac; ORGANIZE_IDLE_DAYS="$2"; shift 2;;
    --minutes) case "${2:-}" in *[!0-9]*|'') die "minutes must be a number";; esac; ORGANIZE_QUICK_MINUTES="$2"; shift 2;;
    *) shift;; esac; done
  save_organize; ok "mode: ${B}$ORGANIZE_MODE${R}  (idle ${ORGANIZE_IDLE_DAYS}d · quick ${ORGANIZE_QUICK_MINUTES}m)"
}
organize_set() {
  load_organize; local k="${1:-}" v="${2:-}"
  case "$k" in
    by-type)   case "$v" in on) ORGANIZE_BY_TYPE=1;; off) ORGANIZE_BY_TYPE=0;; *) die "usage: limpet organize set by-type <on|off>";; esac;;
    dest-root) ORGANIZE_DEST_ROOT="$v";;
    schedule)  case "$v" in daily|hourly|manual) ORGANIZE_SCHEDULE="$v";; *) die "usage: limpet organize set schedule <daily|hourly|manual>";; esac;;
    *) die "usage: limpet organize set <by-type on|off | dest-root PATH | schedule daily|hourly|manual>";;
  esac
  save_organize; ok "set ${B}$k${R} = ${v:-<empty>}"
}
organize_setup() {
  local pf="" pm="" pdays="" pbt=""
  while [ $# -gt 0 ]; do case "$1" in
    --folders) pf="$2"; shift 2;; --mode) pm="$2"; shift 2;; --days) pdays="$2"; shift 2;; --by-type) pbt="$2"; shift 2;;
    --yes|-y) ASSUME_YES=1; shift;; *) shift;; esac; done
  load_organize
  title "limpet organize — setup"
  say "Auto-sort idle files in the folders you choose. Stays ${B}off${R} until you enable at the end."
  hr
  if [ -n "$pf" ]; then IFS=',' read -ra ORGANIZE_WATCH <<< "$pf"
  elif [ "$ASSUME_YES" != 1 ]; then
    printf '%s?%s folders to organize %s(comma-separated, Enter = Downloads)%s: ' "$YEL" "$R" "$DIM" "$R"
    local a; read -r a || true; [ -n "$a" ] && IFS=',' read -ra ORGANIZE_WATCH <<< "$a"
  fi
  if [ -n "$pm" ]; then ORGANIZE_MODE="$pm"
  elif [ "$ASSUME_YES" != 1 ]; then
    say ""; say "${B}When is a file safe to move?${R}"
    say "  ${CYN}1${R}) aged-idle  ${DIM}older than N days AND not open (safest)${R}"
    say "  ${CYN}2${R}) aged       ${DIM}older than N days${R}"
    say "  ${CYN}3${R}) quick      ${DIM}idle a few minutes (aggressive)${R}"
    printf '%s?%s pick 1-3 (Enter = 1): ' "$YEL" "$R"; local p; read -r p || true
    case "$p" in 2) ORGANIZE_MODE=aged;; 3) ORGANIZE_MODE=quick;; *) ORGANIZE_MODE=aged-idle;; esac
  fi
  [ -n "$pdays" ] && ORGANIZE_IDLE_DAYS="$pdays"
  if [ -n "$pbt" ]; then case "$pbt" in off|0) ORGANIZE_BY_TYPE=0;; *) ORGANIZE_BY_TYPE=1;; esac
  elif [ "$ASSUME_YES" != 1 ]; then confirm "auto-create folders by type (Images/, Documents/, …) inside each folder?" && ORGANIZE_BY_TYPE=1 || ORGANIZE_BY_TYPE=0; fi
  seed_organize_rules
  save_organize
  [ "$DRY_RUN" = 1 ] || install_hook
  hr
  ok "configured: ${B}$ORGANIZE_MODE${R} · folders: ${B}$(for w in ${ORGANIZE_WATCH[@]+"${ORGANIZE_WATCH[@]}"}; do printf '%s ' "$w"; done)${R}"
  say "  • Preview first: ${B}limpet organize preview${R}   (edit rules: ${B}limpet organize rule edit${R})"
  if [ "$ASSUME_YES" = 1 ]; then ORGANIZE_ENABLED=1; save_organize; ok "enabled (runs ${ORGANIZE_SCHEDULE})."
  else confirm "enable auto-organize now (runs ${ORGANIZE_SCHEDULE})?" && { ORGANIZE_ENABLED=1; save_organize; ok "enabled."; } || say "  ${DIM}left off — enable later with: limpet organize enable${R}"; fi
}
cmd_organize() {
  local sub="${1:-status}"; shift 2>/dev/null || true
  case "$sub" in
    status|"")  _org_dashboard;;
    --json)     _org_dashboard --json;;
    setup)      organize_setup "$@";;
    enable)     load_organize; ORGANIZE_ENABLED=1; save_organize; [ -f "$ORGANIZE_RULES" ] || seed_organize_rules; install_hook; ok "organize ${GRN}enabled${R} (runs ${ORGANIZE_SCHEDULE}). Preview: ${B}limpet organize preview${R}";;
    disable)    load_organize; ORGANIZE_ENABLED=0; save_organize; ok "organize ${YEL}disabled${R}.";;
    preview)    with_lock organize run_organize preview;;
    run)        with_lock organize _org_run_confirmed "$@";;
    undo)       with_lock organize cmd_organize_undo "$@";;
    log)        cmd_organize_log;;
    mode)       organize_set_mode "$@";;
    watch)      organize_watch "$@";;
    rule)       organize_rule "$@";;
    set)        organize_set "$@";;
    *)          die "usage: limpet organize [status|setup|enable|disable|preview|run|undo|log|mode|watch|rule|set]";;
  esac
}

cmd_help() {
  cat <<EOF
${B}limpet${R} ${DIM}v$LIMPET_VERSION${R} — external drive as primary storage on macOS, with automatic local failover.

${B}USAGE${R}
  limpet <command> [options]

${B}COMMANDS${R}
  ${CYN}setup${R}            Interactive wizard: pick a drive + folders, move them over, install the guard.
                   Flags for automation: --drive <path> --folders a,b,c [--mirror p1,p2] --yes
  ${CYN}status${R}           Show drive + folder state. Add --json for machine output.
  ${CYN}watch${R}            Live view: drive + folder state, redraws on plug/unplug (Ctrl-C to quit).
  ${CYN}doctor${R}           Health-check and offer fixes.
  ${CYN}sync${R}             Run the failover/failback + mirror right now.
  ${CYN}link${R} <path>      Move any extra file/folder onto the drive and symlink it back.
  ${CYN}unlink${R} <path>    Bring a symlinked path back onto the local disk.
  ${CYN}list${R}             List managed folders + any ad-hoc links into the drive.
  ${CYN}env${R}              Offload build-cache env-vars (GOCACHE, GRADLE_USER_HOME, …) to the drive.
                   ${DIM}env add VAR path · env rm VAR · env edit · env (show)${R}
  ${CYN}organize${R}         Opt-in auto file sorter — OFF by default. Sorts idle files by type/rule.
                   ${DIM}organize setup · preview · run · undo · enable/disable · mode · rule · watch${R}
  ${CYN}update${R}           Update limpet to the latest release (--check just checks).
  ${CYN}uninstall${R}        Remove the guard + hook (optionally restore folders to local).
  ${CYN}help${R} | ${CYN}version${R}   This help / version.

${B}GLOBAL${R}
  --yes, -y        Don't prompt (for scripts/agents).
  --dry-run        Print actions without changing anything.

${B}HOW IT WORKS${R}
  Folders become symlinks to the drive. A background ${B}guard${R} (launchd, watches /Volumes) flips them to
  real local folders the instant the drive is unplugged, and back when it returns — merging anything you
  saved offline, never overwriting. A terminal hook finishes the parts macOS won't let a background job do.
  No kernel extensions, no daemons, no network.
EOF
}

# ----------------------------------------------------------------------------- dispatch
main() {
  local cmd="${1:-help}"; shift || true
  # pull global flags out of the args
  local args=(); while [ $# -gt 0 ]; do case "$1" in
    --yes|-y) ASSUME_YES=1;; --dry-run) DRY_RUN=1;; *) args+=("$1");; esac; shift; done
  set -- ${args[@]+"${args[@]}"}
  _notice
  case "$cmd" in
    setup)        cmd_setup "$@";;
    status)       cmd_status "$@";;
    watch)        cmd_watch;;
    doctor)       cmd_doctor;;
    sync)         cmd_sync;;
    link)         cmd_link "$@";;
    unlink)       cmd_unlink "$@";;
    list)         cmd_list;;
    env)          cmd_env "$@";;
    organize)     cmd_organize "$@";;
    update)       cmd_update "$@";;
    uninstall)    cmd_uninstall;;
    __guard)      with_lock guard run_guard;;     # internal: called by launchd + hook
    __mirror)     with_lock mirror run_mirror;;   # internal: called by hook
    __autoupdate) cmd_autoupdate;;                # internal: called by hook (daily)
    __organize)   with_lock organize run_organize_auto;;  # internal: called by hook (gated on enabled)
    __pick-max-semver) _pick_max_semver;;         # internal: pure stdin→stdout, for tests
    version|-v|--version) say "limpet $LIMPET_VERSION";;
    help|-h|--help) cmd_help;;
    *) err "unknown command: $cmd"; say "run ${B}limpet help${R}"; exit 1;;
  esac
}
if [ "${BASH_SOURCE[0]:-$0}" = "$0" ]; then main "$@"; fi
